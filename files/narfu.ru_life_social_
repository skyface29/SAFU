// JavaScript: Отбор ссылок и создание массива
// JavaScript: Отбор ссылок и создание массива
let fileLinks = [];
let query = document.querySelectorAll(".main__content a");

query.forEach((link) => {
 
    let href = link?.getAttribute("href");
    let linkText = link.innerText.trim();

    if (href && linkText) {
        let extensions = ['.pdf', '.doc', '.docx', '.xls', '.xlsx', '.zip', '.rar', '.pptx', '.ppt', '.rtf', '.DOC', '.PDF'];
        let isFileLink = extensions.some(ext => href.includes(ext));

        if (isFileLink) {
          
          
              fileLinks.push(link);
          

        }

    }
});

console.log(fileLinks)

if (fileLinks.length > 0) {
    let data = new FormData();
    
    fileLinks.forEach((link) => {
      
      let href = link.getAttribute("href");

      if(href.includes("/bitrix/redirect.php")){

        let urlParams = new URLSearchParams(href)
        let goto = urlParams.get("goto");
        data.append('href[]', goto);
      }else{
        data.append('href[]', href);
      }

    });

    const requestOptions = {
        method: "POST",
        body: data,
        redirect: "follow"
    };

    fetch("/local/templates/narfu2024/ajax/getfileinfo.php", requestOptions)
        .then((response) => {
            console.log("Ответ получен:", response);
            return response.json();
        })
        .then((res) => {
            //console.log("Данные JSON:", res);
            fileLinks.forEach((link, index) => {
                let href = link.getAttribute("href");
                let fileInfo = res[index];

                //console.log("Обработка файла:", href, fileInfo);

                if(fileInfo.size.length > 0){
                  link.setAttribute("data-extension", fileInfo.extension);
                  link.setAttribute("data-size", fileInfo.size);
                  link.classList.add('link-to-universal-logo');

                  let imgContainer = document.createElement('span');
                  let tagImg = document.createElement('img');
                  let backgroundPath = "/local/templates/narfu2024/img/svg/icon-file.svg";
                  tagImg.setAttribute('src', backgroundPath);
                  tagImg.classList.add('file-tagImg');

                  let fileInfoEl = document.createElement('span');
                  fileInfoEl.innerText = `(${fileInfo.extension.toLowerCase()}, ${fileInfo.size})`;
                  fileInfoEl.classList.add('file-info');

                  let span2 = document.createElement('span');
                  span2.classList.add('inner_link_text');

                  span2.style.display = 'inline';
                  span2.style.paddingLeft = '3px';
                  if (link.classList.contains('custom-link')) {
                      fileInfoEl.style.display = 'block';
                      tagImg.style.transform = 'translateY(1px)';
                  } else {
                      fileInfoEl.style.display = 'inline';
                  }

                  fileInfoEl.style.paddingLeft = '3px';

                  span2.innerText = link.innerText;
                  link.innerText = '';
                  span2.append(fileInfoEl);
                  link.append(span2);
                  link.prepend(tagImg);

                  link.style.display = 'inline-flex';
                  link.style.flexWrap = 'nowrap';
                  link.style.alignItems = 'baseline';
                }
                
            });
        })
        .catch((error) => {
            console.error("Ошибка:", error);
        });
}


