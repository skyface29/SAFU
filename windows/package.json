{
  "name": "safu-desktop",
  "productName": "Арктика",
  "version": "19.9.1",
  "description": "Арктика — расписание, ДЗ, файлы, почта и сайты университета САФУ для Windows и Linux",
  "author": "Зарубин Кирилл (студент группы 151621)",
  "homepage": "https://github.com/skyface29/SAFU",
  "repository": {
    "type": "git",
    "url": "https://github.com/skyface29/SAFU.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.js",
  "desktopName": "arktika.desktop",
  "scripts": {
    "dev": "node scripts/build-electron.mjs --dev && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "tsc --noEmit -p tsconfig.json && npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --x64",
    "test": "node scripts/test.mjs",
    "dist:linux": "npm run build && electron-builder --linux --x64"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@huggingface/transformers": "^3.3.3",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.0",
    "framer-motion": "11.15.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "wait-on": "8.0.1",
    "zustand": "5.0.2"
  },
  "build": {
    "appId": "ru.student.safuhub",
    "productName": "Арктика",
    "copyright": "© 2026 Зарубин Кирилл. Все права защищены",
    "artifactName": "Arktika-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Арктика",
      "artifactName": "Arktika-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Arktika-Portable-${version}.${ext}"
    },
    "protocols": [
      {
        "name": "Арктика",
        "schemes": [
          "safu"
        ]
      }
    ],
    "afterPack": "scripts/linux-after-pack.cjs",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "arktika",
      "icon": "build/icons",
      "category": "Education",
      "synopsis": "Расписание, ДЗ, файлы, почта и сайты САФУ",
      "description": "Неофициальное приложение для студентов и преподавателей САФУ: расписание из РУЗ, домашка, файлы и фото доски по предметам, почта и учебные сайты, синхронизация с iPhone.",
      "maintainer": "Зарубин Кирилл <238922952+skyface29@users.noreply.github.com>",
      "vendor": "Зарубин Кирилл",
      "desktop": {
        "Name": "Арктика",
        "GenericName": "Расписание и учёба САФУ",
        "Comment": "Расписание, ДЗ, файлы, почта и сайты университета САФУ",
        "Keywords": "САФУ;НАрФУ;расписание;пары;ДЗ;домашка;Sakai;safu;narfu;schedule;",
        "StartupWMClass": "arktika"
      },
      "artifactName": "Arktika-${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "Arktika-${version}-x86_64.AppImage"
    },
    "deb": {
      "packageName": "arktika",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64",
        "libgbm1"
      ],
      "recommends": [
        "libayatana-appindicator3-1 | libappindicator3-1",
        "gnome-keyring | kwalletmanager",
        "fonts-noto-color-emoji"
      ],
      "artifactName": "arktika_${version}_amd64.${ext}",
      "afterInstall": "build/linux/after-install.tpl"
    },
    "rpm": {
      "packageName": "arktika",
      "artifactName": "arktika-${version}.x86_64.${ext}",
      "afterInstall": "build/linux/after-install.tpl"
    }
  }
}
