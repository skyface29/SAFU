function Config.UpgradeCost(u: any, level: number): number
	return math.floor(u.base * (u.growth ^ level) + 0.5)
end

function Config.FindUpgrade(list: { any }, id: string): any
	for _, u in list do
		if u.id == id then
			return u
		end
	end
	return nil
end

