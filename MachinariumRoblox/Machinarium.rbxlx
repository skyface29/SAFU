<Item class="ServerScriptService" referent="RBX0000000D"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX0000000C"><Properties><string name="Name">MachinariumServer</string></Properties><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Data: сохранение прогресса игрока (DataStore) + кэш сессии.
-- В Studio без включённого "Enable Studio Access to API Services" игра
-- работает, просто без сохранения.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Machinarium").Config)

local Data = {}
Data.Profiles = {} :: { [Player]: any }

local store: DataStore? = nil
do
	local ok, res = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = res
	else
		warn("[Machinarium] DataStore недоступен, прогресс не сохраняется:", res)
	end
end

local function default()
	return {
		v = 1,
		bolts = 0,
		totalBolts = 0,
		stage = 1,
		parts = {}, -- leg / arm / antenna
		josef = { speed = 0, jump = 0, stretch = 0, magnet = 0, rocket = 0, radar = 0 },
		berta = { rescued = false, cook = 0, basket = 0, love = 0, wheels = 0 },
		skin = "rust",
		skins = { rust = true },
		dress = "cream",
		dresses = { cream = true },
		facts = {},
		eggs = {},
		memories = {},
		quiz = {},
		hasCat = false,
		wins = 0,
		endings = 0,
		hintBook = false,
	}
end

-- дополняем старые сохранения новыми полями
local function reconcile(data, template)
	for k, v in template do
		if data[k] == nil then
			data[k] = if type(v) == "table" then table.clone(v) else v
		elseif type(v) == "table" and type(data[k]) == "table" then
			reconcile(data[k], v)
		end
	end
	return data
end

function Data.Load(player: Player)
	local data = nil
	if store then
		for attempt = 1, 3 do
			local ok, res = pcall(function()
				return store:GetAsync("u_" .. player.UserId)
			end)
			if ok then
				data = res
				break
			end
			warn("[Machinarium] Ошибка загрузки, попытка", attempt, res)
			task.wait(1.5)
		end
	end
	data = reconcile(data or {}, default())
	Data.Profiles[player] = data
	return data
end

function Data.Get(player: Player)
	return Data.Profiles[player]
end

function Data.Save(player: Player)
	local data = Data.Profiles[player]
	if not data or not store then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync("u_" .. player.UserId, data)
	end)
	if not ok then
		warn("[Machinarium] Ошибка сохранения:", err)
	end
end

function Data.Release(player: Player)
	Data.Save(player)
	Data.Profiles[player] = nil
end

function Data.StartAutosave()
	task.spawn(function()
		while true do
			task.wait(120)
			for _, p in Players:GetPlayers() do
				task.spawn(Data.Save, p)
			end
		end
	end)
	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		for _, p in Players:GetPlayers() do
			Data.Save(p)
		end
	end)
end

return Data
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Josef</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Josef: превращает стандартного R15-персонажа Roblox в Йозефа
-- (ржавый робот с головой-«пулей», большими глазами и люком в животе)
-- и управляет его главной способностью — вытягиваться и сжиматься.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Machinarium")
local Config = require(Shared.Config)
local Art = require(Shared.Art)
local C = Config.Colors

local Josef = {}

local function findSkin(id: string)
	for _, s in Config.JosefSkins do
		if s.id == id then
			return s
		end
	end
	return Config.JosefSkins[1]
end

-- Строим детали во временной папке и привариваем к конечности.
local function attach(morph: Folder, limb: BasePart?, build: (Folder, CFrame) -> ())
	if not limb then
		return
	end
	local tmp = Instance.new("Folder")
	build(tmp, limb.CFrame)
	for _, p in tmp:GetChildren() do
		if p:IsA("BasePart") then
			p.Anchored = false
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.Massless = true
			p.CastShadow = true
			local w = Instance.new("Weld")
			w.Part0 = limb
			w.Part1 = p
			w.C0 = limb.CFrame:ToObjectSpace(p.CFrame)
			w.C1 = CFrame.new()
			w.Parent = p
			p.Parent = morph
		else
			p.Parent = morph
		end
	end
	tmp:Destroy()
end

local function hideDefaultBody(character: Model)
	for _, d in character:GetDescendants() do
		if d:IsA("Accessory") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") or d:IsA("BodyColors") then
			d:Destroy()
		elseif d:IsA("Decal") and d.Parent and d.Parent.Name == "Head" then
			d:Destroy()
		end
	end
	for _, p in character:GetChildren() do
		if p:IsA("BasePart") then
			p.Transparency = 1
		end
	end
end

-- data: профиль игрока (для скина, собранных частей и ракетного ранца)
function Josef.BuildMorph(character: Model, data: any)
	local old = character:FindFirstChild("JosefMorph")
	if old then
		old:Destroy()
	end
	hideDefaultBody(character)

	local skin = findSkin(data.skin)
	local body, dark = skin.body, skin.dark
	local mat = if skin.id == "chrome" or skin.id == "gold" then Enum.Material.Metal else Enum.Material.CorrodedMetal
	local darkMat = Enum.Material.Metal
	local parts = data.parts or {}

	local morph = Instance.new("Folder")
	morph.Name = "JosefMorph"
	morph.Parent = character

	local function limb(name: string): BasePart?
		local p = character:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			return p
		end
		return nil
	end

	-- ГОЛОВА: цилиндр + купол, огромные глаза
	attach(morph, limb("Head"), function(f, cf)
		Art.part(f, "Cyl", Vector3.new(0.34, 0.8, 0.34), cf * CFrame.new(0, -0.65, 0), dark, darkMat, "Neck")
		Art.part(f, "Cyl", Vector3.new(1.6, 0.14, 1.6), cf * CFrame.new(0, -0.35, 0), dark, darkMat, "HeadRing")
		Art.part(f, "Cyl", Vector3.new(1.5, 1.15, 1.5), cf * CFrame.new(0, 0.22, 0), body, mat, "HeadCan")
		Art.part(f, "Ball", Vector3.new(1.5, 1.5, 1.5), cf * CFrame.new(0, 0.8, 0), body, mat, "HeadDome")
		Art.eyes(f, cf * CFrame.new(0, 0.35, 0), { size = 0.62, gap = 0.31, z = -0.76 })
		-- «рот»-решётка
		for i = -1, 1 do
			Art.part(f, "Block", Vector3.new(0.08, 0.2, 0.05), cf * CFrame.new(i * 0.14, -0.12, -0.76), C.Soot, nil, "Grill")
		end
		-- болтики по бокам головы
		for _, sx in { -1, 1 } do
			Art.part(f, "CylX", Vector3.new(0.14, 0.34, 0.34), cf * CFrame.new(sx * 0.78, 0.25, 0), C.Brass, Enum.Material.Metal, "EarBolt")
		end
		if parts.antenna then
			Art.part(f, "Cyl", Vector3.new(0.08, 0.9, 0.08), cf * CFrame.new(0.35, 1.7, 0.1) * CFrame.Angles(0, 0, math.rad(-12)), C.Brass, Enum.Material.Metal, "Antenna")
			Art.part(f, "Ball", Vector3.new(0.24, 0.24, 0.24), cf * CFrame.new(0.45, 2.15, 0.1), Color3.fromRGB(255, 120, 80), Enum.Material.Neon, "AntennaTip")
		end
		if skin.hat then
			Art.hat(f, cf * CFrame.new(0, 1.45, 0), skin.hat, 0.85)
		end
	end)

	-- Классический R6-персонаж: упрощённый Йозеф
	if not limb("UpperTorso") and limb("Torso") then
		attach(morph, limb("Torso"), function(f, cf)
			Art.part(f, "Cyl", Vector3.new(1.9, 1.9, 1.9), cf * CFrame.new(0, 0.05, 0), body, mat, "BodyCan")
			Art.part(f, "CylZ", Vector3.new(0.95, 0.95, 0.12), cf * CFrame.new(0, -0.1, -0.95), C.Brass, Enum.Material.Metal, "Hatch")
			Art.part(f, "CylZ", Vector3.new(0.72, 0.72, 0.12), cf * CFrame.new(0, -0.1, -1.0), Color3.fromRGB(50, 40, 34), Enum.Material.Metal, "HatchIn")
			Art.part(f, "Cyl", Vector3.new(0.3, 0.9, 0.3), cf * CFrame.new(0.45, 0.4, 0.95), dark, darkMat, "Exhaust")
		end)
		for _, side in { "Left", "Right" } do
			if side == "Right" or parts.arm then
				attach(morph, limb(side .. " Arm"), function(f, cf)
					Art.part(f, "Ball", Vector3.new(0.6, 0.6, 0.6), cf * CFrame.new(0, 0.7, 0), dark, darkMat, "Shoulder")
					Art.part(f, "Cyl", Vector3.new(0.34, 1.9, 0.34), cf, body, mat, "Arm")
					Art.part(f, "Block", Vector3.new(0.3, 0.5, 0.3), cf * CFrame.new(0, -1.05, 0), dark, darkMat, "Claw")
				end)
			end
			if side == "Right" or parts.leg then
				attach(morph, limb(side .. " Leg"), function(f, cf)
					Art.part(f, "Cyl", Vector3.new(0.36, 1.8, 0.36), cf * CFrame.new(0, 0.1, 0), body, mat, "Leg")
					Art.part(f, "Block", Vector3.new(0.85, 0.34, 1.25), cf * CFrame.new(0, -0.83, -0.15), dark, darkMat, "Foot")
				end)
			end
		end
		return
	end

	-- ТЕЛО-БАНКА с люком в животе
	attach(morph, limb("UpperTorso"), function(f, cf)
		Art.part(f, "Cyl", Vector3.new(1.9, 1.6, 1.9), cf * CFrame.new(0, -0.15, 0), body, mat, "BodyCan")
		Art.part(f, "Cyl", Vector3.new(1.4, 0.22, 1.4), cf * CFrame.new(0, 0.72, 0), dark, darkMat, "Collar")
		Art.part(f, "CylZ", Vector3.new(0.95, 0.95, 0.12), cf * CFrame.new(0, -0.25, -0.93), C.Brass, Enum.Material.Metal, "Hatch")
		Art.part(f, "CylZ", Vector3.new(0.72, 0.72, 0.12), cf * CFrame.new(0, -0.25, -0.98), Color3.fromRGB(50, 40, 34), Enum.Material.Metal, "HatchIn")
		Art.part(f, "Block", Vector3.new(0.12, 0.3, 0.12), cf * CFrame.new(0.42, -0.25, -1.02), C.Brass, Enum.Material.Metal, "HatchLatch")
		for i = -2, 2 do
			local a = i * 0.45
			Art.part(f, "Ball", Vector3.new(0.13, 0.13, 0.13), cf * CFrame.new(math.sin(a) * 0.95, 0.45, -math.cos(a) * 0.95), C.Brass, Enum.Material.Metal, "Rivet")
		end
		-- выхлопная трубка на спине
		Art.part(f, "Cyl", Vector3.new(0.3, 0.9, 0.3), cf * CFrame.new(0.45, 0.3, 0.95), dark, darkMat, "Exhaust")
		if (data.josef and data.josef.rocket or 0) > 0 then
			for _, sx in { -1, 1 } do
				Art.part(f, "Cyl", Vector3.new(0.5, 1.2, 0.5), cf * CFrame.new(sx * 0.45, -0.1, 1.1), Color3.fromRGB(180, 60, 50), Enum.Material.Metal, "Rocket")
				Art.part(f, "Cyl", Vector3.new(0.36, 0.2, 0.36), cf * CFrame.new(sx * 0.45, -0.75, 1.1), C.Soot, Enum.Material.Metal, "Nozzle")
			end
		end
	end)
	attach(morph, limb("LowerTorso"), function(f, cf)
		Art.part(f, "Cyl", Vector3.new(1.55, 0.55, 1.55), cf * CFrame.new(0, 0.05, 0), dark, darkMat, "Hips")
	end)

	-- РУКИ-трубочки (левой нет, пока не найдена на свалке)
	for _, side in { "Left", "Right" } do
		local visible = side == "Right" or parts.arm
		if visible then
			attach(morph, limb(side .. "UpperArm"), function(f, cf)
				Art.part(f, "Ball", Vector3.new(0.6, 0.6, 0.6), cf * CFrame.new(0, 0.4, 0), dark, darkMat, "Shoulder")
				Art.part(f, "Cyl", Vector3.new(0.34, 1.1, 0.34), cf, body, mat, "UpperArm")
			end)
			attach(morph, limb(side .. "LowerArm"), function(f, cf)
				Art.part(f, "Ball", Vector3.new(0.42, 0.42, 0.42), cf * CFrame.new(0, 0.45, 0), dark, darkMat, "Elbow")
				Art.part(f, "Cyl", Vector3.new(0.3, 1.0, 0.3), cf, body, mat, "LowerArm")
			end)
			attach(morph, limb(side .. "Hand"), function(f, cf)
				for _, sx in { -1, 1 } do
					Art.part(f, "Block", Vector3.new(0.14, 0.5, 0.3), cf * CFrame.new(sx * 0.13, -0.1, 0) * CFrame.Angles(0, 0, sx * math.rad(12)), dark, darkMat, "Claw")
				end
			end)
		end
	end

	-- НОГИ-палочки с круглыми ступнями (левая — пока не найдена)
	for _, side in { "Left", "Right" } do
		local visible = side == "Right" or parts.leg
		if visible then
			attach(morph, limb(side .. "UpperLeg"), function(f, cf)
				Art.part(f, "Cyl", Vector3.new(0.38, 1.2, 0.38), cf, body, mat, "UpperLeg")
			end)
			attach(morph, limb(side .. "LowerLeg"), function(f, cf)
				Art.part(f, "Ball", Vector3.new(0.5, 0.5, 0.5), cf * CFrame.new(0, 0.55, 0), dark, darkMat, "Knee")
				Art.part(f, "Cyl", Vector3.new(0.32, 1.2, 0.32), cf, body, mat, "LowerLeg")
			end)
			attach(morph, limb(side .. "Foot"), function(f, cf)
				Art.part(f, "Block", Vector3.new(0.85, 0.34, 1.25), cf * CFrame.new(0, -0.02, -0.15), dark, darkMat, "Foot")
			end)
		else
			-- временная «ходуля» вместо ноги
			attach(morph, limb(side .. "LowerLeg"), function(f, cf)
				Art.part(f, "Cyl", Vector3.new(0.16, 2.2, 0.16), cf * CFrame.new(0, -0.1, 0), C.IronDark, Enum.Material.Metal, "Stilt")
			end)
		end
	end
end

----------------------------------------------------------------------
-- Размер: normal / tall / small
----------------------------------------------------------------------
function Josef.TallScale(data: any): number
	return Config.Size.TallBase + Config.Size.TallPerLevel * (data.josef.stretch or 0)
end

function Josef.CurrentMode(character: Model): string
	return character:GetAttribute("SizeMode") or "normal"
end

local function roomAbove(character: Model, extra: number): boolean
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	for _, off in { Vector3.zero, Vector3.new(0.6, 0, 0), Vector3.new(-0.6, 0, 0), Vector3.new(0, 0, 0.6), Vector3.new(0, 0, -0.6) } do
		local hit = workspace:Raycast(hrp.Position + off, Vector3.new(0, extra, 0), params)
		if hit and hit.Instance.CanCollide then
			return false
		end
	end
	return true
end

-- Возвращает ok, причина
function Josef.SetSize(character: Model, data: any, mode: string): (boolean, string?)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false, "dead"
	end
	local target = Config.Size.Normal
	if mode == "tall" then
		target = Josef.TallScale(data)
	elseif mode == "small" then
		target = Config.Size.Small
	end
	local current = character:GetScale()
	if math.abs(current - target) < 0.01 then
		return true
	end
	if target > current then
		-- хватит ли места над головой?
		local height = 5.2
		if not roomAbove(character, height * (target - current) + 1) then
			return false, "noroom"
		end
	end
	local baseHip = character:GetAttribute("BaseHipHeight") or humanoid.HipHeight / current
	character:SetAttribute("BaseHipHeight", baseHip)
	character:ScaleTo(target)
	humanoid.HipHeight = baseHip * target
	character:SetAttribute("SizeMode", mode)
	-- немного поднимаем, чтобы не застрять в полу при росте
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if hrp and target > current then
		hrp.CFrame += Vector3.new(0, (target - current) * 2.2, 0)
	end
	return true
end

function Josef.ApplyStats(character: Model, data: any)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	humanoid.UseJumpPower = true
	humanoid.WalkSpeed = 16 + 3 * (data.josef.speed or 0)
	humanoid.JumpPower = 50 + 7 * (data.josef.jump or 0)
	character:SetAttribute("AirJumps", data.josef.rocket or 0)
end

-- Перестроить внешний вид (после покупки скина / находки части тела)
function Josef.Refresh(character: Model, data: any)
	local scale = character:GetScale()
	if math.abs(scale - 1) > 0.01 then
		character:ScaleTo(1)
	end
	Josef.BuildMorph(character, data)
	if math.abs(scale - 1) > 0.01 then
		character:ScaleTo(scale)
	end
	Josef.ApplyStats(character, data)
end

return Josef
]]></ProtectedString></Properties></Item>
<Item class="Script" referent="RBX00000009"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Machinarium для Roblox — главный серверный скрипт.
-- Сюжет, болты, прокачка Йозефа и Берты, факты, пасхалки, чекпоинты.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local CollectionService = game:GetService("CollectionService")
local StarterPlayer = game:GetService("StarterPlayer")
local TweenService = game:GetService("TweenService")

StarterPlayer.LoadCharacterAppearance = false
StarterPlayer.CharacterUseJumpPower = true

local Shared = ReplicatedStorage:WaitForChild("Machinarium")
local Config = require(Shared.Config)
local World = require(script.Parent.World)
local Data = require(script.Parent.Data)
local Josef = require(script.Parent.Josef)
local NPC = require(script.Parent.NPC)

local Econ = Config.Economy

----------------------------------------------------------------------
-- Мир
----------------------------------------------------------------------
World.Build()

----------------------------------------------------------------------
-- Remotes
----------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local function remote(className: string, name: string)
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end
local StateEvent: RemoteEvent = remote("RemoteEvent", "State")
local BoltsEvent: RemoteEvent = remote("RemoteEvent", "Bolts")
local NotifyEvent: RemoteEvent = remote("RemoteEvent", "Notify")
local BubbleEvent: RemoteEvent = remote("RemoteEvent", "Bubble")
local KnockEvent: RemoteEvent = remote("RemoteEvent", "Knockback")
local OpenUIEvent: RemoteEvent = remote("RemoteEvent", "OpenUI")
local Request: RemoteFunction = remote("RemoteFunction", "Request")
remotes.Parent = Shared

-- состояние сессии (не сохраняется)
type Session = {
	checkpoint: number?,
	walked: boolean,
	crank: number,
	anger: number,
	bombSeq: { string }?,
	gomokuOpen: number,
	dev: boolean,
	lastSize: number,
	lastTeleport: number,
}
local sessions: { [Player]: Session } = {}

local function notify(player: Player, text: string, kind: string?)
	NotifyEvent:FireClient(player, text, kind or "info")
end

local function bubble(player: Player?, target: Instance, text: string, duration: number?)
	if player then
		BubbleEvent:FireClient(player, target, text, duration or 4)
	else
		BubbleEvent:FireAllClients(target, text, duration or 4)
	end
end

local function pushState(player: Player)
	local data = Data.Get(player)
	if not data then
		return
	end
	local s = sessions[player]
	StateEvent:FireClient(player, data, { dev = s and s.dev or false, checkpoint = s and s.checkpoint or nil })
end

local function leaderstat(player: Player)
	local ls = player:FindFirstChild("leaderstats")
	return ls and ls:FindFirstChild("Болты")
end

local function addBolts(player: Player, amount: number, raw: boolean?)
	local data = Data.Get(player)
	if not data or amount == 0 then
		return 0
	end
	local n = amount
	if not raw and amount > 0 then
		n = math.max(1, math.floor(amount * (1 + 0.1 * (data.berta.love or 0)) + 0.5))
	end
	data.bolts = math.max(0, data.bolts + n)
	if n > 0 then
		data.totalBolts += n
	end
	local ls = leaderstat(player)
	if ls then
		ls.Value = data.bolts
	end
	BoltsEvent:FireClient(player, data.bolts, n)
	return n
end

----------------------------------------------------------------------
-- Сюжет
----------------------------------------------------------------------
local function advance(player: Player, toStage: number)
	local data = Data.Get(player)
	if not data or data.stage >= toStage then
		return false
	end
	local done = Config.Quests[data.stage]
	data.stage = toStage
	addBolts(player, Econ.QuestReward, true)
	if done then
		notify(player, "✅ " .. done.title .. " — выполнено! +" .. Econ.QuestReward .. " 🔩", "quest")
	end
	pushState(player)
	return true
end

local function awardEgg(player: Player, id: string)
	local data = Data.Get(player)
	if not data or data.eggs[id] then
		return false
	end
	local egg
	for _, e in Config.Eggs do
		if e.id == id then
			egg = e
		end
	end
	if not egg then
		return false
	end
	data.eggs[id] = true
	addBolts(player, egg.reward, true)
	if id == "samorost" then
		data.skins.gnome = true
	end
	OpenUIEvent:FireClient(player, "Egg", id)
	pushState(player)
	return true
end

local function unlockFact(player: Player, id: string)
	local data = Data.Get(player)
	if not data then
		return
	end
	local isNew = not data.facts[id]
	if isNew then
		data.facts[id] = true
		addBolts(player, Econ.FactReward, true)
	end
	OpenUIEvent:FireClient(player, "Fact", id, isNew)
	if isNew then
		local count = 0
		for _ in data.facts do
			count += 1
		end
		if count >= #Config.Facts then
			awardEgg(player, "allfacts")
		end
		pushState(player)
	end
end

----------------------------------------------------------------------
-- Точки появления
----------------------------------------------------------------------
local function spawnCFrame(player: Player): CFrame
	local data = Data.Get(player)
	local s = sessions[player]
	local stage = data and data.stage or 1
	if s and s.checkpoint and stage >= 9 then
		local cp = World.TowerCheckpoints[s.checkpoint]
		if cp then
			return cp.CFrame * CFrame.new(0, 4, 0)
		end
	end
	if stage <= 2 then
		return World.Spawns.junk
	elseif stage == 3 then
		return World.Teleports.gate
	elseif stage == 4 then
		return World.Spawns.prison
	elseif stage <= 8 then
		return World.Spawns.square
	elseif stage <= 10 then
		return World.Teleports.tower
	elseif stage == 11 then
		return World.Spawns.towertop
	end
	return World.Spawns.square
end

local function teleport(player: Player, cf: CFrame)
	local char = player.Character
	if char then
		char:PivotTo(cf + Vector3.new(0, 2 * char:GetScale(), 0))
	end
end

----------------------------------------------------------------------
-- Болты
----------------------------------------------------------------------
type Bolt = { part: BasePart, value: number, active: boolean, pos: Vector3 }
local bolts: { Bolt } = {}

local function makeBolt(spot)
	local p = Instance.new("Part")
	p.Name = if spot.big then "BigBolt" else "Bolt"
	p.Shape = Enum.PartType.Cylinder
	local s = if spot.big then 2.6 else 1.5
	p.Size = Vector3.new(0.5 * s, s, s)
	p.CFrame = CFrame.new(spot.pos) * CFrame.Angles(0, 0, 0)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Metal
	p.Color = if spot.big then Color3.fromRGB(255, 200, 60) else Color3.fromRGB(220, 180, 90)
	p.Reflectance = 0.15
	-- дырка гайки
	local hole = Instance.new("Part")
	hole.Shape = Enum.PartType.Cylinder
	hole.Size = Vector3.new(0.52 * s, s * 0.4, s * 0.4)
	hole.CFrame = p.CFrame
	hole.Anchored = true
	hole.CanCollide = false
	hole.CanQuery = false
	hole.CanTouch = false
	hole.Color = Color3.fromRGB(60, 50, 30)
	hole.Material = Enum.Material.Metal
	hole.Name = "Hole"
	hole.Parent = p
	if spot.big then
		local l = Instance.new("PointLight")
		l.Range = 10
		l.Brightness = 1.5
		l.Color = Color3.fromRGB(255, 210, 90)
		l.Parent = p
	end
	CollectionService:AddTag(p, "Bolt")
	p.Parent = World.Root.Bolts
	table.insert(bolts, { part = p, value = if spot.big then Econ.BigBoltValue else Econ.BoltValue, active = true, pos = spot.pos })
end

for _, spot in World.BoltSpots do
	makeBolt(spot)
end

local function setBoltVisible(b: Bolt, visible: boolean)
	local t = if visible then 0 else 1
	b.part.Transparency = t
	local hole = b.part:FindFirstChild("Hole")
	if hole then
		hole.Transparency = t
	end
	local l = b.part:FindFirstChildOfClass("PointLight")
	if l then
		l.Enabled = visible
	end
end

local function collectBolt(player: Player, b: Bolt)
	b.active = false
	setBoltVisible(b, false)
	addBolts(player, b.value)
	task.delay(Econ.BoltRespawn, function()
		b.active = true
		setBoltVisible(b, true)
	end)
end

task.spawn(function()
	while true do
		task.wait(0.1)
		for _, player in Players:GetPlayers() do
			local data = Data.Get(player)
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if data and hrp then
				local r = (Econ.BaseMagnet + Econ.MagnetPerLevel * (data.josef.magnet or 0)) * math.max(1, char:GetScale())
				local r2 = r * r
				local pos = hrp.Position
				local bpos = NPC.BertaPos(player)
				local br = 5 + 3 * (data.berta.basket or 0)
				local br2 = br * br
				local useBerta = bpos ~= nil and (data.berta.basket or 0) > 0
				for _, b in bolts do
					if b.active then
						local d = b.pos - pos
						if d:Dot(d) <= r2 then
							collectBolt(player, b)
						elseif useBerta then
							local d2 = b.pos - bpos
							if d2:Dot(d2) <= br2 then
								collectBolt(player, b)
							end
						end
					end
				end
			end
		end
	end
end)

-- Берта варит масляный суп
task.spawn(function()
	while true do
		task.wait(Econ.BertaCookEvery)
		for _, player in Players:GetPlayers() do
			local data = Data.Get(player)
			if data and data.berta.rescued and (data.berta.cook or 0) > 0 then
				local n = addBolts(player, data.berta.cook * Econ.BertaCookPerLevel)
				local b = NPC.Bertas[player]
				if b then
					bubble(player, b, "🍲✨ +" .. n .. "🔩", 3)
				end
			end
		end
	end
end)

----------------------------------------------------------------------
-- Персонаж
----------------------------------------------------------------------
local function setupCharacter(player: Player, char: Model)
	local data = Data.Get(player)
	if not data then
		return
	end
	local humanoid = char:WaitForChild("Humanoid", 10)
	char:WaitForChild("HumanoidRootPart", 10)
	if not humanoid then
		return
	end
	task.wait()
	char:SetAttribute("SizeMode", "normal")
	char:SetAttribute("BaseHipHeight", humanoid.HipHeight)
	Josef.BuildMorph(char, data)
	Josef.ApplyStats(char, data)
	task.wait()
	char:PivotTo(spawnCFrame(player))
	if data.berta.rescued then
		task.delay(0.3, function()
			NPC.SpawnBerta(player, data)
		end)
	end
end

local function onPlayerAdded(player: Player)
	sessions[player] = { walked = false, crank = 0, anger = 0, gomokuOpen = 0, dev = false, lastSize = 0, lastTeleport = 0 }
	local data = Data.Load(player)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local b = Instance.new("IntValue")
	b.Name = "Болты"
	b.Value = data.bolts
	b.Parent = ls
	local st = Instance.new("IntValue")
	st.Name = "Глава"
	st.Value = data.stage
	st.Parent = ls
	ls.Parent = player
	player.CharacterAdded:Connect(function(char)
		setupCharacter(player, char)
	end)
	if player.Character then
		task.spawn(setupCharacter, player, player.Character)
	end
	player.Chatted:Connect(function(msg)
		if string.find(string.lower(msg), "rebol", 1, true) then
			sessions[player].dev = true
			awardEgg(player, "rebol")
			OpenUIEvent:FireClient(player, "DevMenu")
			pushState(player)
		end
	end)
	pushState(player)
end

Players.PlayerRemoving:Connect(function(player)
	NPC.RemoveBerta(player)
	Data.Release(player)
	sessions[player] = nil
end)

-- «Глава» в таблице лидеров
task.spawn(function()
	while true do
		task.wait(1)
		for _, p in Players:GetPlayers() do
			local data = Data.Get(p)
			local ls = p:FindFirstChild("leaderstats")
			local st = ls and ls:FindFirstChild("Глава")
			if data and st then
				st.Value = data.stage
			end
		end
	end
end)

----------------------------------------------------------------------
-- Братство толкается и отбирает болты
----------------------------------------------------------------------
NPC.Init(World, {
	onBump = function(player: Player, cap: Model, dir: Vector3)
		local data = Data.Get(player)
		if not data or data.stage >= Config.FinalStage or data.stage < 4 then
			return
		end
		local stolen = math.min(data.bolts, Econ.BlackCapSteal)
		if stolen > 0 then
			addBolts(player, -stolen, true)
		end
		KnockEvent:FireClient(player, dir)
		bubble(player, cap, "😈👊 " .. (if stolen > 0 then "💰-" .. stolen else "🎩"), 2.5)
		notify(player, "Чёрная Шляпа толкнул тебя" .. (if stolen > 0 then " и стащил " .. stolen .. " 🔩" else "!"), "bad")
	end,
}, Data.Get)

----------------------------------------------------------------------
-- Касания: убивалки, чекпоинты, сюжетные зоны
----------------------------------------------------------------------
local function playerFromHit(hit: BasePart): (Player?, Model?)
	local model = hit:FindFirstAncestorOfClass("Model")
	while model and not model:FindFirstChildOfClass("Humanoid") do
		model = model:FindFirstAncestorOfClass("Model")
	end
	if not model then
		return nil
	end
	return Players:GetPlayerFromCharacter(model), model
end

local killDebounce: { [Model]: number } = {}
local function hookKill(part: BasePart)
	part.CanTouch = true
	part.Touched:Connect(function(hit)
		local player, char = playerFromHit(hit)
		if not player or not char then
			return
		end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 and (killDebounce[char] or 0) < os.clock() then
			killDebounce[char] = os.clock() + 2
			hum.Health = 0
			local text = part:GetAttribute("KillText")
			if text then
				notify(player, text, "bad")
			end
		end
	end)
end
for _, p in CollectionService:GetTagged("Kill") do
	hookKill(p)
end
CollectionService:GetInstanceAddedSignal("Kill"):Connect(hookKill)

for _, cp in CollectionService:GetTagged("Checkpoint") do
	cp.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if not player then
			return
		end
		local data = Data.Get(player)
		local s = sessions[player]
		if not data or not s or data.stage < 9 then
			return
		end
		local idx = cp:GetAttribute("Index")
		if idx == 1 and (s.checkpoint == nil or s.checkpoint < 1) then
			s.walked = true
		end
		if (s.checkpoint or 0) < idx then
			s.checkpoint = idx
			notify(player, "🚩 Чекпоинт " .. idx .. "/" .. #World.TowerCheckpoints, "info")
			OpenUIEvent:FireClient(player, "Checkpoint", idx)
		end
	end)
end

local function zone(tagName: string, fn: (Player, any, Session) -> ())
	for _, z in CollectionService:GetTagged(tagName) do
		local busy: { [Player]: boolean } = {}
		z.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if not player or busy[player] then
				return
			end
			local data = Data.Get(player)
			local s = sessions[player]
			if data and s then
				busy[player] = true
				fn(player, data, s)
				task.delay(1, function()
					busy[player] = nil
				end)
			end
		end)
	end
end

zone("ArrestZone", function(player, data)
	if data.stage == 3 then
		advance(player, 4)
		OpenUIEvent:FireClient(player, "Arrest")
		task.wait(1.2)
		teleport(player, World.Spawns.prison)
		notify(player, "Братство Чёрной Шляпы бросило тебя в тюрьму! Сожмись [Q] и ищи вентиляцию.", "quest")
	end
end)

zone("PrisonExit", function(player, data)
	if data.stage == 4 then
		advance(player, 5)
	end
end)

zone("TowerTop", function(player, data, s)
	if data.stage == 9 then
		advance(player, 10)
		notify(player, "Ты на вершине! Бомба где-то здесь…", "quest")
	end
	if s.walked then
		s.walked = false
		awardEgg(player, "towerrun")
	end
end)

----------------------------------------------------------------------
-- ProximityPrompt — все взаимодействия
----------------------------------------------------------------------
local partNames = { leg = "ногу", arm = "руку", antenna = "антенну" }

local actions = {}

actions.JosefPart = function(player, data, s, prompt)
	local id = prompt:GetAttribute("PartId")
	if data.parts[id] then
		notify(player, "Это уже на тебе.", "info")
		return
	end
	data.parts[id] = true
	notify(player, "🔧 Йозеф прикрутил " .. (partNames[id] or id) .. "!", "good")
	local char = player.Character
	if char then
		Josef.Refresh(char, data)
	end
	if data.parts.leg and data.parts.arm and data.parts.antenna then
		advance(player, 2)
		notify(player, "Йозеф снова целый! Теперь он умеет ВЫТЯГИВАТЬСЯ — клавиша E.", "quest")
	end
	pushState(player)
end

actions.Guard = function(player, data, s, prompt)
	local guard = World.NPC.Guard
	if data.stage < 2 then
		bubble(player, guard, "🤖❓🦿🦾📡", 3)
		notify(player, "Сначала собери себя на свалке.", "info")
		return
	end
	if data.stage > 2 then
		bubble(player, guard, "👋🚪", 2)
		return
	end
	local char = player.Character
	if not char or char:GetAttribute("SizeMode") ~= "tall" then
		bubble(player, guard, "👀❓ ⬇️🤏", 3)
		notify(player, "Стражник смотрит поверх тебя. Вытянись [E] и позови снова!", "info")
		return
	end
	bubble(player, guard, "😲👍🚪🔓", 3)
	advance(player, 3)
	notify(player, "Ворота открыты! Добро пожаловать в Машинариум.", "quest")
end

actions.Fact = function(player, data, s, prompt)
	unlockFact(player, prompt:GetAttribute("FactId"))
end

actions.Memory = function(player, data, s, prompt)
	local id = prompt:GetAttribute("MemoryId")
	local isNew = not data.memories[id]
	if isNew then
		data.memories[id] = true
		for _, m in Config.Memories do
			if m.id == id then
				addBolts(player, m.reward, true)
			end
		end
		pushState(player)
	end
	OpenUIEvent:FireClient(player, "Memory", id, isNew)
end

actions.Egg = function(player, data, s, prompt)
	local id = prompt:GetAttribute("EggId")
	if id == "creaks" then
		local char = player.Character
		if not char or char:GetAttribute("SizeMode") ~= "small" then
			notify(player, "Слишком большой, чтобы дотянуться до дверцы.", "info")
			return
		end
	end
	if not awardEgg(player, id) then
		notify(player, "Эту пасхалку ты уже нашёл 😉", "info")
	end
end

actions.Crank = function(player, data, s, prompt)
	s.crank += 1
	for _, hand in CollectionService:GetTagged("ClockHand") do
		local pivot: CFrame = hand:GetAttribute("Pivot")
		if pivot then
			local angle = -(s.crank % 12) * math.pi / 6
			TweenService:Create(hand, TweenInfo.new(0.4, Enum.EasingStyle.Back), {
				CFrame = pivot * CFrame.Angles(0, 0, angle) * CFrame.new(0, 1.5, 0),
			}):Play()
		end
	end
	notify(player, "🕰️ " .. (s.crank % 12 == 0 and 12 or s.crank % 12) .. " час(ов)", "info")
	if s.crank % 12 == 0 then
		awardEgg(player, "clock")
	end
end

actions.Cat = function(player, data, s, prompt)
	local cat = World.NPC.Cat
	if data.stage ~= 5 or data.hasCat then
		bubble(player, cat, "😼", 2)
		return
	end
	local char = player.Character
	if not char or char:GetAttribute("SizeMode") ~= "small" then
		bubble(player, cat, "🙀💨", 2)
		notify(player, "Кот боится больших роботов. Сожмись [Q] и подкрадись!", "info")
		return
	end
	data.hasCat = true
	bubble(player, cat, "😾➡️🤖", 2)
	notify(player, "🐈 Кот пойман и спрятан в живот! Неси его музыкантам.", "good")
	pushState(player)
end

actions.Band = function(player, data, s, prompt)
	local mus = World.NPC.Didgeridoo
	if data.stage < 5 then
		bubble(player, mus, "🎵❌", 2)
		return
	end
	if data.stage == 5 then
		if not data.hasCat then
			bubble(player, mus, "🎺🚫 🐈❓", 3)
			notify(player, "Диджериду забито. Нужен кот с площади!", "info")
			return
		end
		data.hasCat = false
		bubble(player, mus, "🐈➡️🎺💨✨🎶", 4)
		advance(player, 6)
		OpenUIEvent:FireClient(player, "Band")
		notify(player, "Оркестр снова играет! Загляни в паб на площади.", "quest")
		return
	end
	bubble(player, mus, "🎶😊🎶", 2)
end

actions.Gomoku = function(player, data, s, prompt)
	if data.stage < 6 then
		bubble(player, prompt.Parent.Parent, "🤖💤", 2)
		return
	end
	s.gomokuOpen = os.clock()
	OpenUIEvent:FireClient(player, "Gomoku")
end

actions.Fan = function(player, data, s, prompt)
	local fan = World.NPC.Fan
	if data.stage < 7 then
		bubble(player, fan, "💤🌀", 2)
		notify(player, "Вентилятор пока дремлет.", "info")
		return
	end
	OpenUIEvent:FireClient(player, "Quiz", s.anger)
end

actions.Berta = function(player, data, s, prompt)
	local captive = prompt.Parent and prompt.Parent.Parent
	if data.stage < 8 then
		bubble(player, captive, "😢🔒", 2)
		return
	end
	if data.stage == 8 then
		data.berta.rescued = true
		advance(player, 9)
		NPC.SpawnBerta(player, data)
		OpenUIEvent:FireClient(player, "BertaRescued")
		notify(player, "❤️ Берта свободна и пойдёт с тобой! Её можно прокачивать.", "quest")
		pushState(player)
	end
end

actions.Bomb = function(player, data, s, prompt)
	if data.stage ~= 10 then
		if data.stage < 10 then
			notify(player, "Сначала доберись до вершины.", "info")
		end
		return
	end
	local ids = {}
	for _, w in Config.BombWires do
		table.insert(ids, w.id)
	end
	for i = #ids, 2, -1 do
		local j = math.random(1, i)
		ids[i], ids[j] = ids[j], ids[i]
	end
	s.bombSeq = ids
	OpenUIEvent:FireClient(player, "Bomb", ids)
end

actions.Friend = function(player, data, s, prompt)
	local friend = World.NPC.Friend
	if data.stage < 11 then
		bubble(player, friend, "😵💫 💣❗", 3)
		if data.stage == 10 then
			notify(player, "Сначала обезвредь бомбу!", "info")
		end
		return
	end
	if data.stage == 11 then
		bubble(nil, friend, "😃❤️🤖", 4)
		advance(player, 12)
		data.endings += 1
		data.skins.blackcap = true
		OpenUIEvent:FireClient(player, "Ending")
		pushState(player)
		return
	end
	bubble(player, friend, "😃👋", 2)
end

actions.Lift = function(player, data, s, prompt)
	local dir = prompt:GetAttribute("Dir")
	if dir == "up" then
		if data.stage < 10 then
			notify(player, "Лифт заработает, когда ты впервые поднимешься наверх пешком.", "info")
			return
		end
		s.walked = false
		teleport(player, World.Teleports.towertop)
	else
		teleport(player, World.Teleports.tower)
	end
end

ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
	local action = prompt:GetAttribute("Action")
	local fn = action and actions[action]
	local data = Data.Get(player)
	local s = sessions[player]
	if fn and data and s then
		local ok, err = pcall(fn, player, data, s, prompt)
		if not ok then
			warn("[Machinarium] action", action, err)
		end
	end
end)

----------------------------------------------------------------------
-- Запросы клиента
----------------------------------------------------------------------
local handlers = {}

handlers.GetState = function(player, data, s)
	return { data = data, session = { dev = s.dev, checkpoint = s.checkpoint } }
end

handlers.SetSize = function(player, data, s, mode)
	if os.clock() - s.lastSize < 0.35 then
		return false, "cooldown"
	end
	s.lastSize = os.clock()
	if mode ~= "tall" and mode ~= "small" and mode ~= "normal" then
		return false
	end
	if mode == "tall" and data.stage < 2 and not s.dev then
		return false, "Сначала найди все свои части на свалке."
	end
	if mode == "small" and data.stage < 4 and not s.dev then
		return false, "Сжиматься Йозеф научится в тюрьме."
	end
	local char = player.Character
	if not char then
		return false
	end
	local ok, why = Josef.SetSize(char, data, mode)
	if not ok and why == "noroom" then
		return false, "Не помещаюсь! Над головой мало места."
	end
	return ok
end

local function buy(player, data, list, store, id)
	local u = Config.FindUpgrade(list, id)
	if not u then
		return false, "?"
	end
	local lvl = store[id] or 0
	if lvl >= u.max then
		return false, "Уже максимум!"
	end
	local cost = Config.UpgradeCost(u, lvl)
	if data.bolts < cost then
		return false, "Не хватает болтов: нужно " .. cost .. " 🔩"
	end
	addBolts(player, -cost, true)
	store[id] = lvl + 1
	return true
end

handlers.BuyJosef = function(player, data, s, id)
	local ok, why = buy(player, data, Config.JosefUpgrades, data.josef, id)
	if ok then
		local char = player.Character
		if char then
			if id == "stretch" and char:GetAttribute("SizeMode") == "tall" then
				Josef.SetSize(char, data, "normal")
			end
			if id == "rocket" then
				Josef.Refresh(char, data)
			else
				Josef.ApplyStats(char, data)
			end
		end
		pushState(player)
	end
	return ok, why
end

handlers.BuyBerta = function(player, data, s, id)
	if not data.berta.rescued then
		return false, "Сначала спаси Берту!"
	end
	local ok, why = buy(player, data, Config.BertaUpgrades, data.berta, id)
	if ok then
		if id == "love" then
			NPC.SpawnBerta(player, data)
		end
		local b = NPC.Bertas[player]
		if b then
			bubble(player, b, "😍⬆️", 2)
		end
		pushState(player)
	end
	return ok, why
end

handlers.Skin = function(player, data, s, id)
	local skin
	for _, sk in Config.JosefSkins do
		if sk.id == id then
			skin = sk
		end
	end
	if not skin then
		return false
	end
	if not data.skins[id] then
		if skin.cost < 0 then
			return false, "Этот скин выдаётся за достижение."
		end
		if data.bolts < skin.cost then
			return false, "Не хватает болтов: нужно " .. skin.cost .. " 🔩"
		end
		addBolts(player, -skin.cost, true)
		data.skins[id] = true
	end
	data.skin = id
	local char = player.Character
	if char then
		Josef.Refresh(char, data)
	end
	pushState(player)
	return true
end

handlers.Dress = function(player, data, s, id)
	if not data.berta.rescued then
		return false, "Сначала спаси Берту!"
	end
	local dress
	for _, d in Config.BertaDresses do
		if d.id == id then
			dress = d
		end
	end
	if not dress then
		return false
	end
	if not data.dresses[id] then
		if data.bolts < dress.cost then
			return false, "Не хватает болтов: нужно " .. dress.cost .. " 🔩"
		end
		addBolts(player, -dress.cost, true)
		data.dresses[id] = true
	end
	data.dress = id
	NPC.SpawnBerta(player, data)
	pushState(player)
	return true
end

handlers.Teleport = function(player, data, s, id)
	if os.clock() - s.lastTeleport < 2 then
		return false, "Подожди секунду…"
	end
	for _, t in Config.Teleports do
		if t.id == id then
			if data.stage < t.stage and not s.dev then
				return false, "Это место ещё не открыто по сюжету."
			end
			local cf = World.Teleports[id]
			if not cf then
				return false
			end
			s.lastTeleport = os.clock()
			s.walked = false
			teleport(player, cf)
			return true
		end
	end
	return false
end

handlers.GomokuResult = function(player, data, s, win)
	if s.gomokuOpen == 0 or os.clock() - s.gomokuOpen < 8 then
		return false
	end
	s.gomokuOpen = 0
	if win ~= true then
		return true
	end
	data.wins += 1
	addBolts(player, Econ.GomokuReward, true)
	if data.stage == 6 then
		advance(player, 7)
		notify(player, "🗝️ Робот отдал ключ от задней комнаты паба! Теперь — теплица.", "quest")
	else
		pushState(player)
	end
	return true
end

handlers.QuizAnswer = function(player, data, s, index, answer)
	local q = Config.FanQuiz[index]
	if not q or data.stage < 7 then
		return nil
	end
	local correct = answer == q.correct
	local opened = false
	if correct then
		if not data.quiz[tostring(index)] then
			data.quiz[tostring(index)] = true
			addBolts(player, 10, true)
			local all = true
			for i = 1, #Config.FanQuiz do
				if not data.quiz[tostring(i)] then
					all = false
				end
			end
			if all then
				awardEgg(player, "quizmaster")
			end
		end
		bubble(player, World.NPC.Fan, "😊👍", 1.5)
	else
		s.anger += 1
		bubble(player, World.NPC.Fan, string.rep("😤", math.min(s.anger, 3)) .. "💨", 1.5)
		if s.anger >= Config.FanAngerToOpen and data.stage == 7 then
			opened = true
			advance(player, 8)
			notify(player, "🌀 Вентилятор взбесился и улетел! В теплице ты нашёл цветок для Берты 🌸", "quest")
		end
	end
	pushState(player)
	return { correct = correct, anger = s.anger, opened = opened }
end

handlers.BombResult = function(player, data, s, order)
	if data.stage ~= 10 or not s.bombSeq or type(order) ~= "table" then
		return false
	end
	for i, id in s.bombSeq do
		if order[i] ~= id then
			s.bombSeq = nil
			notify(player, "💥 Неверный провод! Бомба заискрила — попробуй ещё раз.", "bad")
			return false
		end
	end
	s.bombSeq = nil
	advance(player, 11)
	notify(player, "💣✂️ Бомба обезврежена! Теперь почини друга с большой головой.", "quest")
	return true
end

handlers.Egg = function(player, data, s, id)
	if id == "rebol" then
		s.dev = true
		awardEgg(player, "rebol")
		pushState(player)
		return true
	end
	return false
end

handlers.HintBook = function(player, data, s)
	if not data.hintBook then
		data.hintBook = true
		pushState(player)
	end
	return true
end

handlers.Radar = function(player, data, s)
	if (data.josef.radar or 0) < 1 then
		return nil
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return nil
	end
	local best, bestD, bestName = nil, math.huge, nil
	for _, part in CollectionService:GetTagged("FactTerminal") do
		if not data.facts[part:GetAttribute("FactId")] then
			local d = (part.Position - hrp.Position).Magnitude
			if d < bestD then
				best, bestD, bestName = part.Position, d, "📻 факт"
			end
		end
	end
	for _, part in CollectionService:GetTagged("Egg") do
		if not data.eggs[part:GetAttribute("EggId")] then
			local d = (part.Position - hrp.Position).Magnitude
			if d < bestD then
				best, bestD, bestName = part.Position, d, "🥚 пасхалка"
			end
		end
	end
	if best then
		return { pos = best, name = bestName, dist = math.floor(bestD) }
	end
	return nil
end

handlers.Respawn = function(player, data, s)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.Health = 0
	end
	return true
end

Request.OnServerInvoke = function(player, action, ...)
	local fn = handlers[action]
	local data = Data.Get(player)
	local s = sessions[player]
	if not fn or not data or not s then
		return false
	end
	local ok, a, b = pcall(fn, player, data, s, ...)
	if not ok then
		warn("[Machinarium] request", action, a)
		return false
	end
	return a, b
end

----------------------------------------------------------------------
-- Старт
----------------------------------------------------------------------
Players.CharacterAutoLoads = true
Players.RespawnTime = 2
Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in Players:GetPlayers() do
	task.spawn(onPlayerAdded, p)
end
Data.StartAutosave()

print("[Machinarium] Город построен. Болтов на карте:", #bolts)
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">NPC</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- NPC: Братство Чёрной Шляпы (патруль), кот, Берта-компаньон,
-- движущиеся платформы, пресс на свалке.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Machinarium")
local Config = require(Shared.Config)
local Art = require(Shared.Art)

local NPC = {}
NPC.BlackCaps = {} :: { Model }
NPC.Bertas = {} :: { [Player]: Model }

local World
local hooks

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function groundY(pos: Vector3, ignore: { Instance }): number?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.RespectCanCollide = true
	local hit = workspace:Raycast(pos + Vector3.new(0, 6, 0), Vector3.new(0, -40, 0), params)
	if hit then
		return hit.Position.Y
	end
	return nil
end

----------------------------------------------------------------------
-- Патруль Братства
----------------------------------------------------------------------
local function startPatrol(model: Model, path: { Vector3 }, speed: number)
	local idx = 1
	local pos = path[1]
	local bumpCooldown: { [Player]: number } = {}
	local t0 = math.random() * 10
	RunService.Heartbeat:Connect(function(dt)
		local target = path[idx]
		local delta = flat(target - pos)
		local dist = delta.Magnitude
		if dist < 0.5 then
			idx = idx % #path + 1
		else
			pos += delta.Unit * math.min(dist, speed * dt)
		end
		local bob = math.abs(math.sin((os.clock() + t0) * 6)) * 0.25
		local look = if dist > 0.01 then delta.Unit else Vector3.new(0, 0, -1)
		model:PivotTo(CFrame.lookAt(pos + Vector3.new(0, bob, 0), pos + Vector3.new(0, bob, 0) + look))
	end)
	-- проверка столкновений с игроками (5 раз в секунду)
	task.spawn(function()
		while model.Parent do
			task.wait(0.2)
			for _, plr in Players:GetPlayers() do
				local char = plr.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if hrp then
					local d = flat(hrp.Position - pos)
					if d.Magnitude < 4.2 and math.abs(hrp.Position.Y - pos.Y) < 8 then
						local now = os.clock()
						if (bumpCooldown[plr] or 0) < now then
							bumpCooldown[plr] = now + 3
							if hooks and hooks.onBump then
								hooks.onBump(plr, model, if d.Magnitude > 0.1 then d.Unit else Vector3.new(0, 0, 1))
							end
						end
					end
				end
			end
		end
	end)
end

----------------------------------------------------------------------
-- Кот гуляет по площади
----------------------------------------------------------------------
local function startCat()
	local cat: Model = World.NPC.Cat
	local path = World.NPC.CatPath
	if not cat or not path then
		return
	end
	local idx = 1
	local pos = path[1]
	local pause = 0
	RunService.Heartbeat:Connect(function(dt)
		if pause > 0 then
			pause -= dt
			return
		end
		local target = path[idx]
		local delta = flat(target - pos)
		if delta.Magnitude < 0.4 then
			idx = idx % #path + 1
			pause = 2 + math.random() * 3
			return
		end
		pos += delta.Unit * math.min(delta.Magnitude, 5 * dt)
		cat:PivotTo(CFrame.lookAt(pos, pos + delta.Unit))
	end)
end

----------------------------------------------------------------------
-- Берта-компаньон
----------------------------------------------------------------------
local function dressColor(id: string): Color3
	for _, d in Config.BertaDresses do
		if d.id == id then
			return d.color
		end
	end
	return Config.BertaDresses[1].color
end

function NPC.RemoveBerta(player: Player)
	local b = NPC.Bertas[player]
	if b then
		b:Destroy()
		NPC.Bertas[player] = nil
	end
end

function NPC.SpawnBerta(player: Player, data: any)
	local prev = NPC.Bertas[player]
	local prevCf = if prev then prev:GetPivot() else nil
	NPC.RemoveBerta(player)
	if not data.berta.rescued then
		return
	end
	local model = Art.Berta(dressColor(data.dress), data.berta.love)
	model.Name = "Berta_" .. player.UserId
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanQuery = false
		end
	end
	model:SetAttribute("Owner", player.UserId)
	model:SetAttribute("Bubbles", "❤️|🤖❤️🤖|🍲😊|🌼")
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if prevCf then
		model:PivotTo(prevCf)
	elseif hrp then
		model:PivotTo(hrp.CFrame * CFrame.new(3, -3, 3))
	end
	-- табличка с именем
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(160, 26)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 7.2, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 60
	bb.Adornee = model.PrimaryPart
	local tl = Instance.new("TextLabel")
	tl.Size = UDim2.fromScale(1, 1)
	tl.BackgroundTransparency = 1
	tl.Font = Enum.Font.FredokaOne
	tl.TextScaled = true
	tl.TextColor3 = Config.Colors.BertaPink
	tl.TextStrokeTransparency = 0.4
	tl.Text = "Берта ❤ " .. player.DisplayName
	tl.Parent = bb
	bb.Parent = model.PrimaryPart
	model.Parent = World.Root.NPCs
	NPC.Bertas[player] = model
end

function NPC.BertaPos(player: Player): Vector3?
	local b = NPC.Bertas[player]
	if b and b.PrimaryPart then
		return b.PrimaryPart.Position
	end
	return nil
end

local function startBertaLoop(getData)
	local t = 0
	RunService.Heartbeat:Connect(function(dt)
		t += dt
		if t < 1 / 20 then
			return
		end
		local step = t
		t = 0
		for player, model in NPC.Bertas do
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local data = getData(player)
			if hrp and model.Parent and data then
				local scale = char:GetScale()
				local goal = (hrp.CFrame * CFrame.new(3.5 * scale, 0, 4 * scale)).Position
				local cur = model:GetPivot()
				local curPos = cur.Position
				local dist = (flat(goal) - flat(curPos)).Magnitude
				local gy = groundY(goal, { char, model }) or (hrp.Position.Y - 3 * scale)
				if dist > 70 or math.abs(gy - curPos.Y) > 30 then
					model:PivotTo(CFrame.new(goal.X, gy, goal.Z) * hrp.CFrame.Rotation)
				elseif dist > 1.2 then
					local speed = 18 + 8 * (data.berta.wheels or 0)
					local move = math.min(dist, speed * step)
					local dir = (flat(goal) - flat(curPos)).Unit
					local np = curPos + dir * move
					local y = curPos.Y + (gy - curPos.Y) * math.min(1, step * 10)
					local hop = math.abs(math.sin(os.clock() * 12)) * 0.3
					model:PivotTo(CFrame.lookAt(Vector3.new(np.X, y + hop, np.Z), Vector3.new(np.X, y + hop, np.Z) + dir))
				else
					-- стоим рядом и смотрим туда же, куда Йозеф
					local look = flat(hrp.CFrame.LookVector)
					if look.Magnitude > 0.1 then
						model:PivotTo(CFrame.lookAt(curPos, curPos + look.Unit))
					end
				end
			end
		end
	end)
end

----------------------------------------------------------------------
-- Движущиеся платформы и пресс
----------------------------------------------------------------------
local function startMachines()
	task.spawn(function()
		local sign = 1
		while true do
			task.wait(2.6)
			sign = -sign
			for _, pr in CollectionService:GetTagged("Mover") do
				local r = pr:GetAttribute("Range") or 3
				pr.TargetPosition = r * sign
			end
		end
	end)
	for _, ram in CollectionService:GetTagged("Crusher") do
		local top = ram.CFrame
		local bottom = top - Vector3.new(0, (ram:GetAttribute("Top") or 16) - (ram:GetAttribute("Bottom") or 2.5), 0)
		CollectionService:AddTag(ram, "Kill")
		ram:SetAttribute("KillText", "Хрусь! Попал под пресс.")
		task.spawn(function()
			while ram.Parent do
				task.wait(2.5)
				local down = TweenService:Create(ram, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = bottom })
				down:Play()
				down.Completed:Wait()
				task.wait(0.8)
				local up = TweenService:Create(ram, TweenInfo.new(1.6, Enum.EasingStyle.Sine), { CFrame = top })
				up:Play()
				up.Completed:Wait()
			end
		end)
	end
end

----------------------------------------------------------------------
function NPC.Init(world, h, getData)
	World = world
	hooks = h
	local paths = World.NPC.BlackCapPaths
	for _, kind in { "Leader", "Fat", "Thin" } do
		local m = Art.BlackCap(kind)
		m.Name = "BlackCap_" .. kind
		m:SetAttribute("Bubbles", if kind == "Leader" then "💣🗼😈|🎩🎩🎩|👧🔒🍳" elseif kind == "Fat" then "🍗😋|😈👊|🤖➡️🗑️" else "💰💰|😏|🔪🍎")
		m:SetAttribute("HideAtStage", Config.FinalStage)
		m:SetAttribute("BlackCap", true)
		m:PivotTo(CFrame.new(paths[kind][1]))
		m.Parent = World.Root.NPCs
		table.insert(NPC.BlackCaps, m)
		startPatrol(m, paths[kind], if kind == "Thin" then 7 elseif kind == "Fat" then 4.5 else 5.5)
	end
	startCat()
	startBertaLoop(getData)
	startMachines()
end

return NPC
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- World: процедурная постройка города Машинариум.
-- Свалка → Городская стена → Нижний город (тюрьма, оркестр) → канал →
-- Церковная площадь (фонтан, церковь с часами, паб, кухня Братства) →
-- Теплица → Великая Башня с паркуром и комнатой-головой наверху.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Machinarium")
local Config = require(Shared.Config)
local Art = require(Shared.Art)
local C = Config.Colors

local World = {}

local root: any
local rng = Random.new(2009)

World.Markers = {} :: { [string]: BasePart }
World.Teleports = {} :: { [string]: CFrame }
World.BoltSpots = {} :: { { pos: Vector3, big: boolean } }
World.NPC = {} :: { [string]: any }
World.Spawns = {} :: { [string]: CFrame }

----------------------------------------------------------------------
-- Помощники
----------------------------------------------------------------------
local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function box(parent: Instance, size: Vector3, cf: CFrame | Vector3, color: Color3, material: Enum.Material?, name: string?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = if typeof(cf) == "Vector3" then CFrame.new(cf) else cf
	p.Color = color
	p.Material = material or Enum.Material.Metal
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Name = name or "Part"
	p.Parent = parent
	return p
end

local function cyl(parent: Instance, d: number, h: number, cf: CFrame, color: Color3, material: Enum.Material?, name: string?): BasePart
	local p = Art.part(parent, "Cyl", Vector3.new(d, h, d), cf, color, material or Enum.Material.Metal, name)
	p.Anchored = true
	return p
end

local function ball(parent: Instance, d: number, cf: CFrame, color: Color3, material: Enum.Material?, name: string?): BasePart
	local p = Art.part(parent, "Ball", Vector3.new(d, d, d), cf, color, material or Enum.Material.Metal, name)
	p.Anchored = true
	return p
end

local function wedge(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): WedgePart
	local w = Instance.new("WedgePart")
	w.Anchored = true
	w.Size = size
	w.CFrame = cf
	w.Color = color
	w.Material = material or Enum.Material.Metal
	w.Parent = parent
	return w
end

local function truss(parent: Instance, height: number, pos: Vector3): TrussPart
	local t = Instance.new("TrussPart")
	t.Anchored = true
	t.Size = Vector3.new(2, height, 2)
	t.CFrame = CFrame.new(pos + Vector3.new(0, height / 2, 0))
	t.Color = C.IronDark
	t.Material = Enum.Material.Metal
	t.Parent = parent
	return t
end

local function marker(name: string, pos: Vector3)
	local p = box(root.Markers, Vector3.new(1, 1, 1), pos, C.Brass, Enum.Material.Neon, name)
	p.Transparency = 1
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	World.Markers[name] = p
	return p
end

local function prompt(parent: BasePart, action: string, actionText: string, objectText: string, attrs: { [string]: any }?, dist: number?, hold: number?)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = actionText
	pp.ObjectText = objectText
	pp.MaxActivationDistance = dist or 10
	pp.HoldDuration = hold or 0
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.F
	pp:SetAttribute("Action", action)
	if attrs then
		for k, v in attrs do
			pp:SetAttribute(k, v)
		end
	end
	pp.Parent = parent
	return pp
end

local function light(parent: BasePart, range: number, brightness: number?, color: Color3?)
	local l = Instance.new("PointLight")
	l.Range = range
	l.Brightness = brightness or 1.2
	l.Color = color or C.WarmLight
	l.Shadows = false
	l.Parent = parent
	return l
end

local function bolt(pos: Vector3, big: boolean?)
	table.insert(World.BoltSpots, { pos = pos, big = big == true })
end

local function boltLine(a: Vector3, b: Vector3, n: number)
	for i = 0, n - 1 do
		local t = if n == 1 then 0.5 else i / (n - 1)
		bolt(a:Lerp(b, t))
	end
end

local function tag(inst: Instance, name: string)
	CollectionService:AddTag(inst, name)
end

-- Дверь, которая «открывается» у игрока локально, когда его сюжетная стадия >= stage
local function door(parent: Instance, size: Vector3, cf: CFrame, stage: number, label: string?)
	local d = box(parent, size, cf, C.RustDark, Enum.Material.DiamondPlate, "Door")
	d:SetAttribute("RequiredStage", stage)
	d:SetAttribute("Label", label or "")
	tag(d, "StageDoor")
	-- заклёпки/полосы
	for i = -1, 1, 2 do
		local s = box(parent, Vector3.new(size.X + 0.1, 0.4, size.Z + 0.1), cf * CFrame.new(0, i * size.Y * 0.3, 0), C.Iron, Enum.Material.Metal, "DoorBand")
		s:SetAttribute("RequiredStage", stage)
		s.CanCollide = false
		tag(s, "StageDoor")
	end
	return d
end

-- Инфо-терминал с фактом (старое радио на столбе)
local function factTerminal(id: string, pos: Vector3, rotY: number?)
	local m = Instance.new("Model")
	m.Name = "Fact_" .. id
	m.Parent = root.Facts
	local cf = CFrame.new(pos) * CFrame.Angles(0, math.rad(rotY or 0), 0)
	cyl(m, 0.4, 3, cf * CFrame.new(0, 1.5, 0), C.IronDark)
	local body = box(m, Vector3.new(2.2, 1.6, 1.2), cf * CFrame.new(0, 3.6, 0), C.RustLight, Enum.Material.Wood, "Radio")
	box(m, Vector3.new(1.2, 0.9, 0.1), cf * CFrame.new(-0.3, 3.6, -0.62), C.Soot, Enum.Material.Fabric)
	ball(m, 0.4, cf * CFrame.new(0.65, 3.8, -0.62), C.Brass)
	ball(m, 0.3, cf * CFrame.new(0.65, 3.3, -0.62), C.Brass)
	local lamp = ball(m, 0.4, cf * CFrame.new(0, 4.55, 0), Color3.fromRGB(120, 220, 255), Enum.Material.Neon, "Lamp")
	light(lamp, 8, 1, Color3.fromRGB(120, 220, 255))
	body:SetAttribute("FactId", id)
	tag(body, "FactTerminal")
	prompt(body, "Fact", "Послушать", "📻 Факт о Machinarium", { FactId = id }, 9)
	return body
end

-- Место воспоминания (скамейка со светящимся кругом)
local function memorySpot(id: string, pos: Vector3, rotY: number?)
	local m = Instance.new("Model")
	m.Name = "Memory_" .. id
	m.Parent = root.Memories
	local cf = CFrame.new(pos) * CFrame.Angles(0, math.rad(rotY or 0), 0)
	local seat = box(m, Vector3.new(5, 0.5, 1.6), cf * CFrame.new(0, 1.6, 0), C.RustLight, Enum.Material.Wood, "Bench")
	box(m, Vector3.new(5, 1.6, 0.3), cf * CFrame.new(0, 2.6, 0.7), C.RustLight, Enum.Material.Wood)
	for _, x in { -2, 2 } do
		box(m, Vector3.new(0.3, 1.6, 1.4), cf * CFrame.new(x, 0.8, 0), C.IronDark)
	end
	local glow = cyl(m, 8, 0.1, cf * CFrame.new(0, 0.06, -1.5), Color3.fromRGB(255, 200, 220), Enum.Material.Neon, "Glow")
	glow.Transparency = 0.6
	glow.CanCollide = false
	prompt(seat, "Memory", "Вспомнить", "💭 Воспоминание", { MemoryId = id }, 8)
	return seat
end

local function eggPrompt(part: BasePart, id: string, text: string)
	prompt(part, "Egg", "Осмотреть", text, { EggId = id }, 8)
	tag(part, "Egg")
	part:SetAttribute("EggId", id)
end

----------------------------------------------------------------------
-- Здания
----------------------------------------------------------------------
local houseColors = {
	Color3.fromRGB(150, 96, 60),
	Color3.fromRGB(128, 110, 86),
	Color3.fromRGB(170, 130, 90),
	Color3.fromRGB(110, 96, 80),
	Color3.fromRGB(142, 120, 100),
	Color3.fromRGB(120, 84, 56),
}

-- Дом: коробка с окнами, трубами, крышей. face — направление фасада (градусы по Y).
local function house(parent: Instance, pos: Vector3, w: number, d: number, h: number, face: number?, opts: any?)
	opts = opts or {}
	local m = Instance.new("Model")
	m.Name = opts.name or "House"
	m.Parent = parent
	local cf = CFrame.new(pos) * CFrame.Angles(0, math.rad(face or 0), 0)
	local col = opts.color or houseColors[rng:NextInteger(1, #houseColors)]
	box(m, Vector3.new(w, h, d), cf * CFrame.new(0, h / 2, 0), col, opts.material or Enum.Material.CorrodedMetal, "Walls")
	-- карниз
	box(m, Vector3.new(w + 1, 0.8, d + 1), cf * CFrame.new(0, h + 0.4, 0), C.RustDark, Enum.Material.Metal, "Roof")
	-- окна на фасаде (-Z) и сзади
	local floors = math.max(1, math.floor(h / 7))
	local cols = math.max(1, math.floor(w / 6))
	for f = 1, floors do
		for cIdx = 1, cols do
			local x = -w / 2 + (cIdx - 0.5) * (w / cols)
			local y = (f - 0.5) * (h / floors) + 1
			if not (f == 1 and cIdx == math.ceil(cols / 2) and opts.door ~= false) then
				local lit = rng:NextNumber() < 0.55
				local win = box(m, Vector3.new(2.2, 2.8, 0.2), cf * CFrame.new(x, y, -d / 2 - 0.1), if lit then C.WarmLight else Color3.fromRGB(40, 44, 48), if lit then Enum.Material.Neon else Enum.Material.Glass, "Window")
				win.CanCollide = false
				box(m, Vector3.new(2.8, 0.3, 0.5), cf * CFrame.new(x, y - 1.55, -d / 2 - 0.2), C.RustDark, Enum.Material.Metal, "Sill")
			end
		end
	end
	if opts.door ~= false then
		box(m, Vector3.new(3, 5, 0.3), cf * CFrame.new(0, 2.5, -d / 2 - 0.15), C.RustDark, Enum.Material.Wood, "FrontDoor")
	end
	-- трубы и дымоходы
	if opts.chimney ~= false then
		local chim = cyl(m, 1.4, 4, cf * CFrame.new(w * 0.3, h + 2.5, d * 0.2), C.IronDark, Enum.Material.Metal, "Chimney")
		if rng:NextNumber() < 0.5 then
			local smoke = Instance.new("ParticleEmitter")
			smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
			smoke.Rate = 2
			smoke.Lifetime = NumberRange.new(4, 6)
			smoke.Speed = NumberRange.new(2, 3)
			smoke.Size = NumberSequence.new(1, 5)
			smoke.Transparency = NumberSequence.new(0.6, 1)
			smoke.Color = ColorSequence.new(Color3.fromRGB(120, 110, 100))
			smoke.EmissionDirection = Enum.NormalId.Right
			smoke.Parent = chim
		end
	end
	-- водосточная труба сбоку
	cyl(m, 0.6, h, cf * CFrame.new(w / 2 + 0.4, h / 2, -d / 2 + 1), C.Iron, Enum.Material.Metal, "Pipe")
	return m, cf
end

----------------------------------------------------------------------
-- Освещение и атмосфера: тёплый ржавый закат
----------------------------------------------------------------------
local function setupLighting()
	Lighting.ClockTime = 17.4
	Lighting.GeographicLatitude = 30
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(90, 70, 55)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 120, 90)
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	for _, c in Lighting:GetChildren() do
		if c:IsA("PostEffect") or c:IsA("Atmosphere") or c:IsA("Sky") then
			c:Destroy()
		end
	end
	local atm = Instance.new("Atmosphere")
	atm.Density = 0.36
	atm.Offset = 0.1
	atm.Color = Color3.fromRGB(210, 170, 120)
	atm.Decay = Color3.fromRGB(120, 80, 50)
	atm.Glare = 0.3
	atm.Haze = 1.6
	atm.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.TintColor = Color3.fromRGB(255, 236, 205)
	cc.Saturation = -0.15
	cc.Contrast = 0.08
	cc.Brightness = 0.02
	cc.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 30
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.6
	rays.Parent = Lighting
end

----------------------------------------------------------------------
-- Земля и границы
----------------------------------------------------------------------
local function buildGround()
	local g = root.Ground
	box(g, Vector3.new(1200, 4, 1200), Vector3.new(0, -2, 20), Color3.fromRGB(96, 84, 70), Enum.Material.Concrete, "Baseplate")
	-- брусчатка площади
	box(g, Vector3.new(170, 0.4, 130), Vector3.new(0, 0.2, 30), Color3.fromRGB(128, 112, 92), Enum.Material.Cobblestone, "SquareFloor")
	-- улица Нижнего города
	box(g, Vector3.new(36, 0.4, 130), Vector3.new(0, 0.2, 172), Color3.fromRGB(110, 98, 84), Enum.Material.Cobblestone, "LowtownStreet")
	box(g, Vector3.new(200, 0.4, 24), Vector3.new(0, 0.2, 160), Color3.fromRGB(110, 98, 84), Enum.Material.Cobblestone, "LowtownCross")
	-- земля свалки
	box(g, Vector3.new(300, 0.4, 170), Vector3.new(0, 0.2, 335), Color3.fromRGB(92, 78, 60), Enum.Material.Ground, "JunkFloor")

	-- внешние стены города (x = ±230, z = -300..240)
	local walls = root.Walls
	local wallH = 46
	local function wallSeg(a: Vector3, b: Vector3)
		local mid = (a + b) / 2
		local len = (b - a).Magnitude
		local cf = CFrame.lookAt(mid, b) * CFrame.new(0, wallH / 2, 0)
		box(walls, Vector3.new(10, wallH, len), cf, Color3.fromRGB(120, 100, 80), Enum.Material.Brick, "CityWall")
		-- зубцы
		local n = math.floor(len / 8)
		for i = 0, n - 1 do
			box(walls, Vector3.new(10.4, 3, 4), cf * CFrame.new(0, wallH / 2 + 1.5, -len / 2 + 4 + i * 8), Color3.fromRGB(110, 90, 72), Enum.Material.Brick, "Crenel")
		end
	end
	wallSeg(Vector3.new(-230, 0, -300), Vector3.new(-230, 0, 240))
	wallSeg(Vector3.new(230, 0, -300), Vector3.new(230, 0, 240))
	wallSeg(Vector3.new(-230, 0, -300), Vector3.new(230, 0, -300))
	-- южная стена с воротами (разрыв x = -12..12)
	wallSeg(Vector3.new(-230, 0, 240), Vector3.new(-12, 0, 240))
	wallSeg(Vector3.new(12, 0, 240), Vector3.new(230, 0, 240))
	-- арка над воротами
	box(walls, Vector3.new(24, wallH - 22, 10), Vector3.new(0, 22 + (wallH - 22) / 2, 240), Color3.fromRGB(120, 100, 80), Enum.Material.Brick, "GateArch")
	-- площадка стражника на стене
	box(walls, Vector3.new(26, 1, 14), Vector3.new(0, wallH + 0.5, 240), C.IronDark, Enum.Material.DiamondPlate, "GuardDeck")
	-- угловые башенки
	for _, p in { Vector3.new(-230, 0, 240), Vector3.new(230, 0, 240), Vector3.new(-230, 0, -300), Vector3.new(230, 0, -300), Vector3.new(-20, 0, 240), Vector3.new(20, 0, 240) } do
		cyl(walls, 16, wallH + 10, CFrame.new(p + Vector3.new(0, (wallH + 10) / 2, 0)), Color3.fromRGB(112, 92, 74), Enum.Material.Brick, "WallTower")
		cyl(walls, 18, 2, CFrame.new(p + Vector3.new(0, wallH + 11, 0)), C.RustDark, Enum.Material.Metal)
		local roofC = 17
		for k = 0, 4 do
			cyl(walls, roofC - k * 3.4, 2, CFrame.new(p + Vector3.new(0, wallH + 13 + k * 2, 0)), C.Rust, Enum.Material.CorrodedMetal)
		end
	end

	-- силуэты дальнего города за стенами
	for i = 1, 70 do
		local ang = (i / 70) * math.pi * 2
		local r = rng:NextNumber(470, 560)
		local h = rng:NextNumber(60, 170)
		local pos = Vector3.new(math.cos(ang) * r, h / 2, math.sin(ang) * r + 20)
		local w = rng:NextNumber(20, 45)
		local p = box(root.Skyline, Vector3.new(w, h, w), CFrame.new(pos) * CFrame.Angles(0, ang, 0), Color3.fromRGB(80, 66, 56), Enum.Material.CorrodedMetal, "Silhouette")
		p.CastShadow = false
		if rng:NextNumber() < 0.5 then
			cyl(root.Skyline, 2, rng:NextNumber(15, 40), CFrame.new(pos + Vector3.new(0, h / 2 + 10, 0)), C.IronDark, Enum.Material.Metal).CastShadow = false
		end
		if rng:NextNumber() < 0.35 then
			ball(root.Skyline, w * 0.9, CFrame.new(pos + Vector3.new(0, h / 2, 0)), Color3.fromRGB(90, 72, 60), Enum.Material.CorrodedMetal).CastShadow = false
		end
	end
end

----------------------------------------------------------------------
-- 1. Свалка
----------------------------------------------------------------------
local function junkPile(parent: Instance, center: Vector3, radius: number, height: number, count: number)
	for _ = 1, count do
		local ang = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(0, radius)
		local t = 1 - r / radius
		local pos = center + Vector3.new(math.cos(ang) * r, t * height * rng:NextNumber(0.4, 1), math.sin(ang) * r)
		local size = Vector3.new(rng:NextNumber(2, 7), rng:NextNumber(1, 4), rng:NextNumber(2, 7))
		local col = houseColors[rng:NextInteger(1, #houseColors)]:Lerp(C.RustDark, rng:NextNumber(0, 0.5))
		local kind = rng:NextInteger(1, 4)
		local cf = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, 6.28), rng:NextNumber(-0.5, 0.5))
		if kind == 1 then
			box(parent, size, cf, col, Enum.Material.CorrodedMetal, "Junk")
		elseif kind == 2 then
			cyl(parent, size.X * 0.6, size.Z, cf, col, Enum.Material.CorrodedMetal, "JunkPipe")
		elseif kind == 3 then
			wedge(parent, size, cf, col, Enum.Material.CorrodedMetal)
		else
			local tire = cyl(parent, size.X * 0.7, 1, cf, C.Soot, Enum.Material.Rubber, "JunkTire")
			tire.Size = Vector3.new(1, size.X * 0.7, size.X * 0.7)
		end
	end
end

local function buildJunkyard()
	local j = root.Junkyard
	-- забор свалки
	for _, x in { -150, 150 } do
		for z = 245, 410, 10 do
			box(j, Vector3.new(1, 12, 10), Vector3.new(x, 6, z), C.IronDark, Enum.Material.CorrodedMetal, "Fence")
		end
	end
	for x = -150, 150, 10 do
		box(j, Vector3.new(10, 12, 1), Vector3.new(x, 6, 412), C.IronDark, Enum.Material.CorrodedMetal, "Fence")
	end

	-- кучи мусора (декор)
	junkPile(j, Vector3.new(-90, 0, 330), 26, 14, 70)
	junkPile(j, Vector3.new(90, 0, 360), 24, 12, 60)
	junkPile(j, Vector3.new(-40, 0, 390), 16, 8, 35)
	junkPile(j, Vector3.new(110, 0, 280), 18, 10, 40)
	junkPile(j, Vector3.new(-120, 0, 275), 14, 8, 30)

	-- стартовая площадка (здесь Йозеф «очнулся»)
	local pad = cyl(j, 16, 0.6, CFrame.new(0, 0.3, 385), C.IronDark, Enum.Material.DiamondPlate, "WakePad")
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.CFrame = CFrame.new(0, 0.5, 385)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = j
	local _ = pad
	World.Spawns.junk = CFrame.new(0, 4, 385) * CFrame.Angles(0, 0, 0)
	World.Teleports.junk = World.Spawns.junk

	-- Кран с магнитом (на верху — АНТЕННА Йозефа)
	local craneBase = Vector3.new(60, 0, 320)
	box(j, Vector3.new(8, 2, 8), craneBase + Vector3.new(0, 1, 0), C.IronDark, Enum.Material.Metal, "CraneBase")
	truss(j, 36, craneBase + Vector3.new(4, 2, 0))
	box(j, Vector3.new(6, 1, 6), craneBase + Vector3.new(0, 36.5, 0), C.Rust, Enum.Material.DiamondPlate, "CraneCabin")
	box(j, Vector3.new(3, 1.5, 34), CFrame.new(craneBase + Vector3.new(0, 38, -15)), Color3.fromRGB(190, 140, 50), Enum.Material.Metal, "CraneArm")
	cyl(j, 0.3, 14, CFrame.new(craneBase + Vector3.new(0, 30, -30)), C.Soot, Enum.Material.Metal, "Rope")
	cyl(j, 6, 1.5, CFrame.new(craneBase + Vector3.new(0, 22.5, -30)), C.IronDark, Enum.Material.Metal, "Magnet")
	-- кабина крана
	box(j, Vector3.new(5, 4, 5), craneBase + Vector3.new(0, 39, 3), Color3.fromRGB(190, 140, 50), Enum.Material.Metal, "Cab")

	-- Пресс-дробилка (опасно!)
	local press = Vector3.new(-60, 0, 280)
	box(j, Vector3.new(14, 1, 14), press + Vector3.new(0, 0.5, 0), C.IronDark, Enum.Material.DiamondPlate, "PressFloor")
	for _, x in { -7, 7 } do
		box(j, Vector3.new(2, 20, 2), press + Vector3.new(x, 10, 0), C.Iron, Enum.Material.Metal, "PressPillar")
	end
	local ram = box(j, Vector3.new(12, 3, 12), press + Vector3.new(0, 16, 0), C.Rust, Enum.Material.CorrodedMetal, "PressRam")
	ram:SetAttribute("Bottom", press.Y + 2.5)
	ram:SetAttribute("Top", press.Y + 16)
	tag(ram, "Crusher")
	bolt(press + Vector3.new(0, 2, 0), true)

	-- Мини-паркур по мусору к ноге Йозефа (куча слева)
	local steps = {
		Vector3.new(-40, 3, 360),
		Vector3.new(-50, 6, 352),
		Vector3.new(-60, 9, 346),
		Vector3.new(-70, 12, 340),
		Vector3.new(-80, 15, 334),
		Vector3.new(-90, 18, 330),
	}
	for i, p in steps do
		local s = box(j, Vector3.new(6, 1.4, 6), CFrame.new(p) * CFrame.Angles(0, i * 0.4, 0), if i % 2 == 0 then C.Rust else C.IronDark, Enum.Material.CorrodedMetal, "JunkStep")
		local _ = s
		bolt(p + Vector3.new(0, 3, 0))
	end
	-- НОГА
	local leg = Art.part(j, "Cyl", Vector3.new(0.5, 2.6, 0.5), CFrame.new(-90, 20.5, 330) * CFrame.Angles(0, 0, math.rad(70)), C.Rust, Enum.Material.Metal, "JosefLeg")
	leg.Anchored = true
	light(leg, 10, 2, Color3.fromRGB(255, 220, 150))
	prompt(leg, "JosefPart", "Забрать", "🦿 Нога Йозефа", { PartId = "leg" }, 10)
	marker("Q1", Vector3.new(-90, 22, 330))

	-- РУКА в старой трубе
	local pipeCf = CFrame.new(95, 3, 300)
	local pipe = cyl(j, 7, 18, pipeCf * CFrame.Angles(math.rad(90), 0, 0), C.Iron, Enum.Material.CorrodedMetal, "BigPipe")
	pipe.CanCollide = false
	for k = -1, 1, 2 do
		cyl(j, 7.6, 0.6, pipeCf * CFrame.new(0, 0, k * 8.7) * CFrame.Angles(math.rad(90), 0, 0), C.RustDark, Enum.Material.Metal).CanCollide = false
	end
	box(j, Vector3.new(6, 0.5, 18), pipeCf * CFrame.new(0, -3.1, 0), C.IronDark, Enum.Material.Metal, "PipeFloor")
	local arm = Art.part(j, "Cyl", Vector3.new(0.4, 2.2, 0.4), CFrame.new(95, 1.2, 300) * CFrame.Angles(math.rad(90), 0, 0), C.Rust, Enum.Material.Metal, "JosefArm")
	arm.Anchored = true
	light(arm, 10, 2, Color3.fromRGB(255, 220, 150))
	prompt(arm, "JosefPart", "Забрать", "🦾 Рука Йозефа", { PartId = "arm" }, 10)

	-- АНТЕННА на кране
	local ant = Art.part(j, "Cyl", Vector3.new(0.15, 1.8, 0.15), CFrame.new(craneBase + Vector3.new(2.2, 38, -2.2)), C.Brass, Enum.Material.Metal, "JosefAntenna")
	ant.Anchored = true
	local tip = ball(j, 0.4, CFrame.new(craneBase + Vector3.new(2.2, 39, -2.2)), Color3.fromRGB(255, 120, 80), Enum.Material.Neon, "AntennaTip")
	light(tip, 12, 2)
	prompt(ant, "JosefPart", "Забрать", "📡 Антенна Йозефа", { PartId = "antenna" }, 10)
	boltLine(craneBase + Vector3.new(0, 40.5, -6), craneBase + Vector3.new(0, 40.5, -30), 7)

	-- Пасхалка: мухомор Amanita среди мусора
	local shroom = Art.Amanita(0.8)
	Art.place(shroom, CFrame.new(-125, 0.4, 395), j)
	eggPrompt(shroom.PrimaryPart, "amanita", "🍄 Мухомор")

	-- Пасхалка: вишенка Chuchel на высокой мусорной башне (по фермам)
	local tower = Vector3.new(125, 0, 395)
	truss(j, 30, tower + Vector3.new(4.5, 0, 0))
	box(j, Vector3.new(7, 1, 7), tower + Vector3.new(0, 28.5, 0), C.Rust, Enum.Material.CorrodedMetal, "CherryTop")
	local cherry = ball(j, 1.2, CFrame.new(tower + Vector3.new(0, 29.8, 0)), Color3.fromRGB(200, 20, 40), Enum.Material.SmoothPlastic, "Cherry")
	cyl(j, 0.1, 1.2, CFrame.new(tower + Vector3.new(0.2, 30.8, 0)) * CFrame.Angles(0, 0, 0.4), C.Moss, Enum.Material.SmoothPlastic)
	eggPrompt(cherry, "chuchel", "🍒 Вишенка")

	-- Воспоминание: купание — у масляной лужи
	local pool = cyl(j, 22, 0.3, CFrame.new(-10, 0.45, 300), C.Oil, Enum.Material.Glass, "OilPool")
	pool.Transparency = 0.1
	pool.Reflectance = 0.3
	memorySpot("m_swim", Vector3.new(-10, 0.4, 314), 180)

	factTerminal("f12", Vector3.new(12, 0.4, 372), 200)
	factTerminal("f01", Vector3.new(-18, 0.4, 372), 160)
	factTerminal("f27", Vector3.new(-118, 0.4, 390), 90)

	-- болты по свалке
	for _ = 1, 40 do
		bolt(Vector3.new(rng:NextNumber(-130, 130), 2, rng:NextNumber(262, 405)))
	end
	bolt(Vector3.new(95, 1.5, 306), true)
end

