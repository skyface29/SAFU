<Item class="Workspace" referent="RBX00000002"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool><float name="Gravity">196.2</float></Properties><Item class="Terrain" referent="RBX00000001"><Properties><string name="Name">Terrain</string></Properties></Item>
