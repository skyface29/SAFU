Config.Facts = {
	{ id = "f01", title = "Что это за игра", text = "Machinarium — point-and-click адвенчура-головоломка чешской студии Amanita Design из Брно." },
	{ id = "f02", title = "Дата выхода", text = "Игра вышла в октябре 2009 года на ПК и Mac. Изначально она была сделана на Flash." },
	{ id = "f03", title = "Автор", text = "Автор идеи и режиссёр — Якуб Дворский (Jakub Dvorský), основатель Amanita Design." },
	{ id = "f04", title = "Музыка", text = "Музыку написал Томаш Дворжак, известный как Floex. Саундтрек выходил отдельным альбомом и даже на виниле." },
	{ id = "f05", title = "Маленькая команда", text = "Игру около трёх лет делали семь чешских разработчиков на собственные сбережения. Бюджет на рекламу — примерно 1000 долларов." },
	{ id = "f06", title = "Награда IGF", text = "На Independent Games Festival 2009 Machinarium победил в номинации «Excellence in Visual Art»." },
	{ id = "f07", title = "Имя героя", text = "Главного героя зовут Йозеф — в честь Йозефа Чапека, художника и писателя, который придумал слово «робот»." },
	{ id = "f08", title = "Слово «робот»", text = "Слово «робот» впервые прозвучало в пьесе Карела Чапека «R.U.R.» (1920). Подсказал его брат Карела — Йозеф." },
	{ id = "f09", title = "Без слов", text = "В игре нет ни одной строчки диалога. Персонажи «говорят» анимированными пузырями мыслей с картинками." },
	{ id = "f10", title = "Вытянуться и сжаться", text = "Йозеф умеет вытягиваться вверх и сжиматься в коротышку — на этом построены многие головоломки." },
	{ id = "f11", title = "Инвентарь в животе", text = "Подобранные предметы Йозеф прячет прямо внутрь своего корпуса." },
	{ id = "f12", title = "Начало истории", text = "Игра начинается на свалке: Йозефа выбросили туда по кусочкам, и он собирает себя сам." },
	{ id = "f13", title = "Братство Чёрной Шляпы", text = "Злодеи — Братство Чёрной Шляпы: Главарь и двое подручных, Толстый и Тонкий. Они задумали взорвать Башню города." },
	{ id = "f14", title = "Берта", text = "Берта — девушка Йозефа. Братство держит её взаперти на кухне в своём логове за пабом и заставляет готовить." },
	{ id = "f15", title = "Друг с большой головой", text = "Наверху Башни сидит огромноголовый робот — друг Йозефа и Берты. Братство вывело его из строя, а Йозеф его чинит." },
	{ id = "f16", title = "Финал", text = "Йозеф обезвреживает бомбу, спускает Братство в сток, спасает Берту, и вдвоём они улетают в закат." },
	{ id = "f17", title = "Воспоминания", text = "Если Йозеф стоит без дела, он вспоминает: как они с Бертой купались, играли в пейнтбол, праздновали дни рождения." },
	{ id = "f18", title = "Подсказки", text = "Помощь в игре двух видов: маленькая подсказка-пузырь на каждой локации и книга прохождения." },
	{ id = "f19", title = "Пауки и ключ", text = "Книгу прохождения можно открыть, только пройдя мини-игру: провести ключ сквозь пауков к замку." },
	{ id = "f20", title = "Чит-код rebol", text = "Кирпичи в мини-игре с пауками иногда складываются в слово «rebol». Если набрать rebol на титульном экране — откроется тестовое меню разработчиков." },
	{ id = "f21", title = "Пять в ряд", text = "В игре есть мини-игра «пять в ряд» (гомоку) против робота." },
	{ id = "f22", title = "Злой вентилятор", text = "Чтобы попасть в теплицу, нужно разозлить вентилятор, специально отвечая на его вопросы неправильно." },
	{ id = "f23", title = "Кот и диджериду", text = "Уличному музыканту нужно прочистить диджериду — и в этом помогает кот." },
	{ id = "f24", title = "Продажи", text = "Machinarium разошёлся тиражом более 4 миллионов копий. Эти деньги позволили студии независимо сделать Botanicula и Samorost 3." },
	{ id = "f25", title = "Платформы", text = "Игру портировали на Windows, macOS, Linux, iOS, Android, PS3, PS Vita, PS4, Xbox One, Nintendo Switch и другие." },
	{ id = "f26", title = "Definitive Version", text = "Позже вышла Machinarium Definitive Version — переиздание на новом движке без Flash." },
	{ id = "f27", title = "Мухомор", text = "Название студии Amanita — от латинского Amanita muscaria, мухомора. Отсюда сказочный и сюрреалистичный стиль их игр." },
	{ id = "f28", title = "Йозеф в Samorost", text = "Йозеф появляется камео в серии Samorost — например, играет на гитаре на вечеринке у костра." },
	{ id = "f29", title = "Другие игры Amanita", text = "Samorost 1–3, Botanicula, Chuchel, Pilgrims, Creaks, Happy Game — у студии узнаваемый ручной стиль." },
	{ id = "f30", title = "Город Машинариум", text = "Весь город построен из ржавого металлолома, а все жители — роботы. Над городом возвышается огромная Башня." },
}

