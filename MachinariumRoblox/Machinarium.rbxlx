</Item>
<Item class="StarterPlayer" referent="RBX00000014"><Properties><string name="Name">StarterPlayer</string><bool name="LoadCharacterAppearance">false</bool><bool name="CharacterUseJumpPower">true</bool><float name="CharacterJumpPower">50</float><float name="CameraMaxZoomDistance">60</float><token name="GameSettingsAvatar">1</token></Properties><Item class="StarterPlayerScripts" referent="RBX00000013"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000012"><Properties><string name="Name">MachinariumClient</string></Properties><Item class="LocalScript" referent="RBX0000000E"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Machinarium для Roblox — клиент: HUD, магазины прокачки, энциклопедия,
-- книга подсказок, телепорты, управление размером Йозефа.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local TextChatService = game:GetService("TextChatService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Machinarium")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = Shared:WaitForChild("Remotes")
local Request: RemoteFunction = Remotes:WaitForChild("Request")

local UI = require(script.Parent:WaitForChild("UI"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local Minigames = require(script.Parent:WaitForChild("Minigames"))
local C = Config.Colors

local data = nil
local session = { dev = false }

UI.Init()
Effects.Init()

local function req(...)
	local ok, a, b = pcall(Request.InvokeServer, Request, ...)
	if not ok then
		return false, "Ошибка связи"
	end
	return a, b
end

local function countKeys(t)
	local n = 0
	for _ in t or {} do
		n += 1
	end
	return n
end

----------------------------------------------------------------------
-- Подсказки (книга прохождения)
----------------------------------------------------------------------
local Hints = {
	[1] = "Нога — на вершине мусорной горы слева: прыгай по ступенькам-обломкам. Рука — внутри большой ржавой трубы справа. Антенна — на кране: залезай по решётчатой ферме.",
	[2] = "Подойди к переговорной трубе у ворот, нажми <b>E</b> (вытянуться) и позови стражника клавишей <b>F</b>.",
	[3] = "Просто пройди в открытые ворота.",
	[4] = "Нажми <b>Q</b>, чтобы сжаться. Вентиляция — низкая дыра у пола в восточной стене камеры (рядом с нарами).",
	[5] = "Кот гуляет вокруг фонтана на площади (перейди канал по мосту). Сожмись (<b>Q</b>), подойди и поймай. Потом неси его к оркестру на сцене в Нижнем городе.",
	[6] = "Паб — справа (восток) на площади. Робот сидит за игровым столом. Блокируй его, когда у него 3–4 в ряд!",
	[7] = "Теплица — слева за площадью. Отвечай вентилятору <b>неправильно</b> 3 раза — он разозлится и улетит.",
	[8] = "Кухня Братства — за пабом, ближе к каналу. Дверь теперь открыта. Нажми <b>F</b> рядом с Бертой.",
	[9] = "Башня — самое высокое здание, за площадью. Прыгай по спирали: синие полосы бьют током, шестерёнки крутятся, пар подбрасывает. Жёлтые платформы с флажком — чекпоинты.",
	[10] = "Бомба стоит у стены в комнате наверху. Запомни порядок проводов в пузыре Главаря и режь в том же порядке.",
	[11] = "Большеголовый друг сидит в центре комнаты. Подойди и почини его (<b>F</b>).",
	[12] = "Собери все 30 фактов (радио на столбах), 12 пасхалок и 5 воспоминаний (скамейки). Прокачай Йозефа и Берту до максимума!",
}

----------------------------------------------------------------------
-- HUD
----------------------------------------------------------------------
local gui = UI.Gui

local boltPanel = UI.panel(gui, UDim2.fromOffset(190, 52), UDim2.fromOffset(12, 12), C.Paper)
local boltLabel = UI.label(boltPanel, "🔩 0", UDim2.new(1, -16, 1, 0), UDim2.fromOffset(12, 0), 30)

local questPanel = UI.panel(gui, UDim2.fromOffset(330, 0), UDim2.new(1, -342, 0, 60), C.Paper)
questPanel.AutomaticSize = Enum.AutomaticSize.Y
UI.pad(questPanel, 10)
UI.list(questPanel, 4)
local questTitle = UI.label(questPanel, "", UDim2.new(1, 0, 0, 26), nil, 22, C.RustDark)
local questText = UI.label(questPanel, "", UDim2.new(1, 0, 0, 0), nil, 17)
questText.AutomaticSize = Enum.AutomaticSize.Y
questText.LayoutOrder = 2

local sizeLabel = UI.label(gui, "", UDim2.fromOffset(260, 26), UDim2.fromOffset(16, 70), 18, Color3.fromRGB(255, 240, 210))
sizeLabel.TextStrokeTransparency = 0.4

-- нижняя панель кнопок
local bar = Instance.new("Frame")
bar.BackgroundTransparency = 1
bar.Size = UDim2.new(1, -24, 0, 54)
bar.Position = UDim2.new(0, 12, 1, -66)
bar.Parent = gui
local barList = UI.list(bar, 8, true)
barList.HorizontalAlignment = Enum.HorizontalAlignment.Center

local function barButton(text: string, color: Color3, order: number, fn)
	local b = UI.button(bar, text, UDim2.fromOffset(118, 50), nil, color, fn)
	b.TextSize = 17
	b.LayoutOrder = order
	return b
end

local openJosef, openBerta, openBook, openEncyclopedia, openTeleport, openDev

-- вытянуться / сжаться (повторное нажатие — вернуть обычный рост)
local function toggleSize(want: string)
	if not data then
		return
	end
	local mode = if player.Character and player.Character:GetAttribute("SizeMode") == want then "normal" else want
	local ok, why = req("SetSize", mode)
	if not ok and why and why ~= "cooldown" then
		UI.toast(why, "info")
	end
end

local tallBtn = barButton("⬆️ Вытянуться [E]", C.Rust, 1, function()
	toggleSize("tall")
end)
local smallBtn = barButton("⬇️ Сжаться [Q]", C.Rust, 2, function()
	toggleSize("small")
end)
barButton("🤖 Йозеф", Color3.fromRGB(150, 110, 70), 3, function()
	openJosef()
end)
local bertaBtn = barButton("👧 Берта", C.BertaPink, 4, function()
	openBerta()
end)
barButton("📖 Подсказка", Color3.fromRGB(120, 110, 90), 5, function()
	openBook()
end)
barButton("📚 Факты", Color3.fromRGB(90, 120, 120), 6, function()
	openEncyclopedia()
end)
barButton("🗺️ Телепорт", Color3.fromRGB(90, 100, 130), 7, function()
	openTeleport()
end)
local devBtn = barButton("🛠️ rebol", Color3.fromRGB(60, 60, 60), 8, function()
	openDev()
end)
devBtn.Visible = false

----------------------------------------------------------------------
-- Обновление HUD и мира
----------------------------------------------------------------------
local function updateQuest()
	if not data then
		return
	end
	local q = Config.Quests[data.stage] or Config.Quests[Config.FinalStage]
	questTitle.Text = q.title
	local extra = ""
	if data.stage == 1 then
		local got = {}
		for _, id in { "leg", "arm", "antenna" } do
			table.insert(got, (if data.parts[id] then "✅ " else "⬜ ") .. ({ leg = "нога", arm = "рука", antenna = "антенна" })[id])
		end
		extra = "\n" .. table.concat(got, "   ")
	elseif data.stage == 5 then
		extra = if data.hasCat then "\n🐈 Кот у тебя в животе!" else "\n🐈 Кот ещё не пойман"
	elseif data.stage == Config.FinalStage then
		extra = string.format("\n📻 %d/%d   🥚 %d/%d   💭 %d/%d", countKeys(data.facts), #Config.Facts, countKeys(data.eggs), #Config.Eggs, countKeys(data.memories), #Config.Memories)
	end
	questText.Text = q.text .. extra
	-- маркер цели
	local markers = workspace:FindFirstChild("Machinarium") and workspace.Machinarium:FindFirstChild("Markers")
	local target = nil
	if data.stage == 5 and not data.hasCat then
		target = workspace.Machinarium.NPCs:FindFirstChild("Кот")
	elseif data.stage == 1 then
		-- ближайшая несобранная часть
		for _, pp in workspace.Machinarium.Junkyard:GetDescendants() do
			if pp:IsA("ProximityPrompt") and pp:GetAttribute("Action") == "JosefPart" and not data.parts[pp:GetAttribute("PartId")] then
				target = pp.Parent
				break
			end
		end
	elseif markers and q.marker ~= "" then
		target = markers:FindFirstChild(q.marker)
	end
	Effects.setMarker(target, "🎯")
	tallBtn.Visible = data.stage >= 2 or session.dev
	smallBtn.Visible = data.stage >= 4 or session.dev
	bertaBtn.Visible = data.berta.rescued
	devBtn.Visible = session.dev == true
end

local shownBolts = 0
local function setBolts(n: number, delta: number?)
	if delta and delta ~= 0 then
		local pop = UI.label(gui, (if delta > 0 then "+" else "") .. delta .. " 🔩", UDim2.fromOffset(160, 30), UDim2.fromOffset(40, 60), 24, if delta > 0 then Color3.fromRGB(255, 220, 120) else Color3.fromRGB(255, 120, 100))
		pop.TextStrokeTransparency = 0.3
		TweenService:Create(pop, TweenInfo.new(0.9), { Position = UDim2.fromOffset(40, 30), TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.delay(1, function()
			pop:Destroy()
		end)
	end
	local from = shownBolts
	shownBolts = n
	task.spawn(function()
		for i = 1, 10 do
			boltLabel.Text = "🔩 " .. math.floor(from + (n - from) * i / 10)
			task.wait(0.02)
		end
	end)
end

local function onState(newData, newSession)
	local prevStage = data and data.stage
	data = newData
	session = newSession or session
	if data then
		data.bolts = data.bolts or 0
		setBolts(data.bolts)
		updateQuest()
		Effects.applyStage(data.stage, data)
		if prevStage and prevStage ~= data.stage then
			local q = Config.Quests[data.stage]
			if q then
				UI.toast("📜 Новая глава: <b>" .. q.title .. "</b>", "quest")
			end
		end
	end
end

----------------------------------------------------------------------
-- Окно: прокачка Йозефа
----------------------------------------------------------------------
local function upgradeRow(parent, u, level, onBuy)
	local row = UI.panel(parent, UDim2.new(1, -10, 0, 74), nil, Color3.fromRGB(245, 234, 208))
	UI.label(row, u.icon, UDim2.fromOffset(50, 74), UDim2.fromOffset(8, 0), 38)
	UI.label(row, "<b>" .. u.name .. "</b>  " .. string.rep("●", level) .. string.rep("○", u.max - level), UDim2.new(1, -220, 0, 30), UDim2.fromOffset(62, 6), 20)
	UI.label(row, u.desc, UDim2.new(1, -220, 0, 34), UDim2.fromOffset(62, 34), 16, Color3.fromRGB(110, 80, 60))
	local text = if level >= u.max then "МАКС" else ("🔩 " .. Config.UpgradeCost(u, level))
	local b = UI.button(row, text, UDim2.fromOffset(140, 50), UDim2.new(1, -150, 0, 12), if level >= u.max then Color3.fromRGB(120, 120, 110) else Color3.fromRGB(110, 150, 80), onBuy)
	return row, b
end

function openJosef()
	if not data then
		return
	end
	local _, content = UI.window("🤖 Прокачка Йозефа", 620, 560)
	local sc = UI.scroll(content, UDim2.fromScale(1, 1))
	UI.list(sc, 8)
	local header = UI.label(sc, "Болты: <b>🔩 " .. data.bolts .. "</b>. Тратишь болты — Йозеф становится лучше!", UDim2.new(1, -10, 0, 30), nil, 18)
	header.LayoutOrder = 0
	for i, u in Config.JosefUpgrades do
		local row = upgradeRow(sc, u, data.josef[u.id] or 0, function()
			local ok, why = req("BuyJosef", u.id)
			if ok then
				UI.toast(u.icon .. " " .. u.name .. " улучшен!", "good")
				task.wait(0.15)
				openJosef()
			else
				UI.toast(why or "Не получилось", "bad")
			end
		end)
		row.LayoutOrder = i
	end
	local sk = UI.label(sc, "<b>🎨 Покраска</b>", UDim2.new(1, -10, 0, 34), nil, 22)
	sk.LayoutOrder = 50
	for i, s in Config.JosefSkins do
		local owned = data.skins[s.id]
		local row = UI.panel(sc, UDim2.new(1, -10, 0, 54), nil, Color3.fromRGB(245, 234, 208))
		row.LayoutOrder = 50 + i
		local sw = Instance.new("Frame")
		sw.Size = UDim2.fromOffset(38, 38)
		sw.Position = UDim2.fromOffset(10, 8)
		sw.BackgroundColor3 = s.body
		UI.corner(sw, 19)
		UI.stroke(sw, UI.Ink, 2)
		sw.Parent = row
		UI.label(row, s.name .. (if data.skin == s.id then "  <b>(надет)</b>" else ""), UDim2.new(1, -220, 1, 0), UDim2.fromOffset(60, 0), 19)
		local txt = if owned then "Надеть" elseif s.cost < 0 then "🔒 достижение" else ("🔩 " .. s.cost)
		UI.button(row, txt, UDim2.fromOffset(140, 40), UDim2.new(1, -150, 0, 7), if owned then C.Rust else Color3.fromRGB(110, 150, 80), function()
			local ok, why = req("Skin", s.id)
			if ok then
				openJosef()
			else
				UI.toast(why or "Не получилось", "bad")
			end
		end)
	end
end

----------------------------------------------------------------------
-- Окно: прокачка Берты
----------------------------------------------------------------------
function openBerta()
	if not data then
		return
	end
	local _, content = UI.window("👧 Берта", 620, 560)
	if not data.berta.rescued then
		UI.label(content, "Берта в плену у Братства Чёрной Шляпы. Пройди сюжет, чтобы её спасти!", UDim2.new(1, 0, 0, 80), nil, 22)
		return
	end
	local sc = UI.scroll(content, UDim2.fromScale(1, 1))
	UI.list(sc, 8)
	local h = UI.label(sc, "Берта ходит за тобой, варит масляный суп, собирает болты и радует Йозефа ❤️", UDim2.new(1, -10, 0, 44), nil, 18)
	h.LayoutOrder = 0
	for i, u in Config.BertaUpgrades do
		local row = upgradeRow(sc, u, data.berta[u.id] or 0, function()
			local ok, why = req("BuyBerta", u.id)
			if ok then
				UI.toast(u.icon .. " " .. u.name .. " — Берта довольна!", "good")
				task.wait(0.15)
				openBerta()
			else
				UI.toast(why or "Не получилось", "bad")
			end
		end)
		row.LayoutOrder = i
	end
	local dh = UI.label(sc, "<b>👗 Платья</b>", UDim2.new(1, -10, 0, 34), nil, 22)
	dh.LayoutOrder = 50
	for i, d in Config.BertaDresses do
		local owned = data.dresses[d.id]
		local row = UI.panel(sc, UDim2.new(1, -10, 0, 54), nil, Color3.fromRGB(245, 234, 208))
		row.LayoutOrder = 50 + i
		local sw = Instance.new("Frame")
		sw.Size = UDim2.fromOffset(38, 38)
		sw.Position = UDim2.fromOffset(10, 8)
		sw.BackgroundColor3 = d.color
		UI.corner(sw, 19)
		UI.stroke(sw, UI.Ink, 2)
		sw.Parent = row
		UI.label(row, d.name .. (if data.dress == d.id then "  <b>(надето)</b>" else ""), UDim2.new(1, -220, 1, 0), UDim2.fromOffset(60, 0), 19)
		UI.button(row, if owned then "Надеть" else ("🔩 " .. d.cost), UDim2.fromOffset(140, 40), UDim2.new(1, -150, 0, 7), if owned then C.BertaPink else Color3.fromRGB(110, 150, 80), function()
			local ok, why = req("Dress", d.id)
			if ok then
				openBerta()
			else
				UI.toast(why or "Не получилось", "bad")
			end
		end)
	end
end

----------------------------------------------------------------------
-- Окно: энциклопедия (факты, пасхалки, воспоминания)
----------------------------------------------------------------------
function openEncyclopedia(tab: string?)
	if not data then
		return
	end
	tab = tab or "facts"
	local _, content = UI.window("📚 Энциклопедия Machinarium", 660, 600)
	local tabs = Instance.new("Frame")
	tabs.BackgroundTransparency = 1
	tabs.Size = UDim2.new(1, 0, 0, 44)
	tabs.Parent = content
	UI.list(tabs, 6, true)
	local defs = {
		{ "facts", "📻 Факты " .. countKeys(data.facts) .. "/" .. #Config.Facts },
		{ "eggs", "🥚 Пасхалки " .. countKeys(data.eggs) .. "/" .. #Config.Eggs },
		{ "mem", "💭 Воспоминания " .. countKeys(data.memories) .. "/" .. #Config.Memories },
	}
	for i, d in defs do
		local b = UI.button(tabs, d[2], UDim2.new(1 / 3, -4, 1, 0), nil, if tab == d[1] then C.Rust else Color3.fromRGB(150, 130, 110), function()
			openEncyclopedia(d[1])
		end)
		b.TextSize = 16
		b.LayoutOrder = i
	end
	local sc = UI.scroll(content, UDim2.new(1, 0, 1, -52), UDim2.fromOffset(0, 52))
	UI.list(sc, 6)
	local function entry(order, title, body, unlocked)
		local f = UI.panel(sc, UDim2.new(1, -10, 0, 0), nil, if unlocked then Color3.fromRGB(245, 234, 208) else Color3.fromRGB(200, 190, 170))
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.LayoutOrder = order
		UI.pad(f, 8)
		UI.list(f, 2)
		UI.label(f, "<b>" .. title .. "</b>", UDim2.new(1, 0, 0, 24), nil, 19)
		local b = UI.label(f, body, UDim2.new(1, 0, 0, 0), nil, 16, Color3.fromRGB(90, 66, 50))
		b.AutomaticSize = Enum.AutomaticSize.Y
		b.LayoutOrder = 2
	end
	if tab == "facts" then
		for i, f in Config.Facts do
			local got = data.facts[f.id]
			entry(i, (if got then "📻 " else "🔒 ") .. i .. ". " .. (if got then f.title else "???"), if got then f.text else "Найди радио-терминал на столбе, чтобы узнать этот факт.", got)
		end
	elseif tab == "eggs" then
		for i, e in Config.Eggs do
			local got = data.eggs[e.id]
			entry(i, (if got then "🥚 " else "❔ ") .. (if got then e.name else "Секрет"), (if got then "Найдено! " else "Подсказка: ") .. e.hint .. "  (+" .. e.reward .. " 🔩)", got)
		end
	else
		for i, m in Config.Memories do
			local got = data.memories[m.id]
			entry(i, (if got then "💭 " else "🔒 ") .. (if got then m.name else "???"), if got then m.bubble else "Посиди на скамейке со светящимся кругом — Йозеф что-нибудь вспомнит.", got)
		end
	end
end

----------------------------------------------------------------------
-- Окно: книга подсказок (сначала — мини-игра с пауками!)
----------------------------------------------------------------------
function openBook()
	if not data then
		return
	end
	if not data.hintBook then
		Minigames.Spiders(UI, function(success)
			if success then
				req("HintBook")
				data.hintBook = true
				task.defer(openBook)
			end
		end)
		return
	end
	local _, content = UI.window("📖 Книга подсказок", 560, 420)
	local q = Config.Quests[data.stage] or Config.Quests[Config.FinalStage]
	UI.label(content, "<b>" .. q.title .. "</b>", UDim2.new(1, 0, 0, 34), nil, 24, C.RustDark)
	local body = UI.label(content, Hints[data.stage] or "", UDim2.new(1, 0, 0, 200), UDim2.fromOffset(0, 40), 20)
	body.TextYAlignment = Enum.TextYAlignment.Top
	UI.label(content, "<i>Управление: E — вытянуться, Q — сжаться, F — взаимодействие, пробел в воздухе — ракетный ранец.</i>", UDim2.new(1, 0, 0, 50), UDim2.new(0, 0, 1, -52), 16, Color3.fromRGB(110, 80, 60))
end

----------------------------------------------------------------------
-- Окно: телепорт
----------------------------------------------------------------------
function openTeleport()
	if not data then
		return
	end
	local _, content = UI.window("🗺️ Куда поехать?", 460, 520)
	local sc = UI.scroll(content, UDim2.fromScale(1, 1))
	UI.list(sc, 6)
	for i, t in Config.Teleports do
		local open = data.stage >= t.stage or session.dev
		local b = UI.button(sc, (if open then "🚋 " else "🔒 ") .. t.name, UDim2.new(1, -10, 0, 50), nil, if open then C.Rust else Color3.fromRGB(140, 130, 120), function()
			local ok, why = req("Teleport", t.id)
			if ok then
				UI.closeWindow()
			elseif why then
				UI.toast(why, "info")
			end
		end)
		b.LayoutOrder = i
	end
	local r = UI.button(sc, "🔄 Возродиться (если застрял)", UDim2.new(1, -10, 0, 44), nil, Color3.fromRGB(120, 90, 80), function()
		req("Respawn")
		UI.closeWindow()
	end)
	r.LayoutOrder = 100
end

----------------------------------------------------------------------
-- Меню разработчика rebol (как в оригинале — прыжки по уровням)
----------------------------------------------------------------------
function openDev()
	local _, content = UI.window("🛠️ rebol — меню разработчиков", 460, 520)
	local sc = UI.scroll(content, UDim2.fromScale(1, 1))
	UI.list(sc, 6)
	local l = UI.label(sc, "Как в оригинальной игре: секретное слово <b>rebol</b> открывает тестовое меню. Все локации доступны!", UDim2.new(1, -10, 0, 60), nil, 17)
	l.LayoutOrder = 0
	for i, t in Config.Teleports do
		local b = UI.button(sc, "✨ " .. t.name, UDim2.new(1, -10, 0, 44), nil, Color3.fromRGB(70, 70, 80), function()
			req("Teleport", t.id)
		end)
		b.LayoutOrder = i
	end
end

----------------------------------------------------------------------
-- Сообщения от сервера
----------------------------------------------------------------------
Remotes:WaitForChild("State").OnClientEvent:Connect(onState)
Remotes:WaitForChild("Bolts").OnClientEvent:Connect(function(n, delta)
	if data then
		data.bolts = n
	end
	setBolts(n, delta)
end)
Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(text, kind)
	UI.toast(text, kind)
end)
Remotes:WaitForChild("Bubble").OnClientEvent:Connect(function(target, text, dur)
	Effects.bubble(target, text, dur)
end)
Remotes:WaitForChild("Knockback").OnClientEvent:Connect(function(dir)
	Effects.knockback(dir)
end)

Remotes:WaitForChild("OpenUI").OnClientEvent:Connect(function(kind, a, b)
	if kind == "Fact" then
		for i, f in Config.Facts do
			if f.id == a then
				UI.card("Факт №" .. i .. ": " .. f.title, f.text .. (if b then "\n\n<b>+" .. Config.Economy.FactReward .. " 🔩</b>" else ""), "📻")
			end
		end
	elseif kind == "Egg" then
		for _, e in Config.Eggs do
			if e.id == a then
				UI.card("Пасхалка найдена!", "<b>" .. e.name .. "</b>\n" .. e.hint .. "\n\n<b>+" .. e.reward .. " 🔩</b>", "🥚", Color3.fromRGB(255, 230, 170))
			end
		end
	elseif kind == "Memory" then
		for _, m in Config.Memories do
			if m.id == a then
				UI.card("Воспоминание: " .. m.name, m.bubble .. (if b then "\n\n<b>+" .. m.reward .. " 🔩</b>" else ""), "💭", Color3.fromRGB(255, 225, 235))
				if player.Character then
					Effects.bubble(player.Character, m.bubble, 6)
				end
			end
		end
	elseif kind == "Gomoku" then
		Minigames.Gomoku(UI, function(win)
			local ok = req("GomokuResult", win)
			if win and ok then
				UI.toast("🏆 Победа в «пять в ряд»! +" .. Config.Economy.GomokuReward .. " 🔩", "good")
			end
		end)
	elseif kind == "Quiz" then
		Minigames.Quiz(UI, a or 0, function(index, answer)
			return req("QuizAnswer", index, answer)
		end)
	elseif kind == "Bomb" then
		Minigames.Bomb(UI, a, function(order)
			return req("BombResult", order) == true
		end)
	elseif kind == "Arrest" then
		Effects.arrest(UI)
	elseif kind == "Band" then
		Effects.band()
	elseif kind == "BertaRescued" then
		UI.card("Берта спасена!", "Теперь она ходит за тобой. Открой меню «👧 Берта», чтобы прокачать её: суп, корзинка, цветок любви, колёсики и платья.", "❤️", Color3.fromRGB(255, 225, 235))
	elseif kind == "Ending" then
		UI.closeWindow()
		Effects.ending(UI, data)
		UI.card("Город спасён!", "Ты прошёл сюжет. Открыт скин «В чёрной шляпе». Теперь собирай все факты, пасхалки и воспоминания, прокачивай Йозефа и Берту!", "🌅", Color3.fromRGB(255, 214, 150))
	elseif kind == "DevMenu" then
		session.dev = true
		devBtn.Visible = true
		openDev()
	elseif kind == "Checkpoint" then
		local tower = workspace.Machinarium:FindFirstChild("Tower")
		if tower then
			for _, f in tower:GetChildren() do
				if f:GetAttribute("CheckpointFlag") and f:GetAttribute("CheckpointFlag") <= a then
					f.Color = Color3.fromRGB(90, 190, 90)
				end
			end
		end
	end
end)

----------------------------------------------------------------------
-- Клавиши: E — вытянуться, Q — сжаться. Секретное слово rebol.
----------------------------------------------------------------------
local typed = ""
UserInputService.InputBegan:Connect(function(input, gp)
	if gp or UserInputService:GetFocusedTextBox() then
		return
	end
	if input.UserInputType ~= Enum.UserInputType.Keyboard then
		return
	end
	local name = input.KeyCode.Name
	if #name == 1 then
		typed = string.sub(typed .. string.lower(name), -5)
		if typed == "rebol" then
			typed = ""
			local ok = req("Egg", "rebol")
			if ok then
				session.dev = true
				devBtn.Visible = true
				openDev()
			end
			return
		end
	end
	if input.KeyCode == Enum.KeyCode.E then
		toggleSize("tall")
	elseif input.KeyCode == Enum.KeyCode.Q then
		toggleSize("small")
	end
end)

-- новый чат: слово rebol
pcall(function()
	TextChatService.MessageReceived:Connect(function(msg)
		if msg.TextSource and msg.TextSource.UserId == player.UserId and string.find(string.lower(msg.Text), "rebol", 1, true) then
			local ok = req("Egg", "rebol")
			if ok then
				session.dev = true
				devBtn.Visible = true
			end
		end
	end)
end)

-- радар (если прокачан)
task.spawn(function()
	local radarLabel = UI.label(gui, "", UDim2.fromOffset(300, 26), UDim2.fromOffset(16, 96), 18, Color3.fromRGB(160, 230, 255))
	radarLabel.TextStrokeTransparency = 0.4
	while true do
		task.wait(2)
		if data and (data.josef.radar or 0) > 0 then
			local r = req("Radar")
			if type(r) == "table" then
				radarLabel.Text = "📡 Ближайший " .. r.name .. ": " .. r.dist .. " м"
			else
				radarLabel.Text = "📡 Всё найдено!"
			end
		end
		local char = player.Character
		local mode = char and char:GetAttribute("SizeMode") or "normal"
		sizeLabel.Text = if mode == "tall" then "📏 Йозеф вытянулся" elseif mode == "small" then "🤏 Йозеф сжался" else ""
	end
end)

Effects.idleMemories(function()
	return data
end)

-- начальное состояние
task.spawn(function()
	local st = req("GetState")
	if type(st) == "table" and st.data then
		onState(st.data, st.session)
	end
	UI.card("Machinarium", "Ты — Йозеф, маленький робот. Братство Чёрной Шляпы разобрало тебя и выкинуло на свалку, похитило Берту и хочет взорвать Башню.\n\n<b>E</b> — вытянуться, <b>Q</b> — сжаться, <b>F</b> — взаимодействие.\nСобирай 🔩 болты и прокачивайся!", "🤖")
end)
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Effects: пузыри мыслей, двери по сюжету, вращение болтов, маркер цели,
-- паровые трамплины, двойной прыжок, толчки, воспоминания, финальная сцена.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Machinarium")
local Config = require(Shared:WaitForChild("Config"))
local Art = require(Shared:WaitForChild("Art"))
local C = Config.Colors

local Effects = {}
local player = Players.LocalPlayer
local root: any

----------------------------------------------------------------------
-- Пузыри мыслей (в Machinarium нет слов — только картинки)
----------------------------------------------------------------------
local activeBubbles: { [Instance]: BillboardGui } = {}

local function adorneeOf(target: Instance): (BasePart?, number)
	if target:IsA("Model") then
		local pp = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)
		local ok, size = pcall(function()
			return target:GetExtentsSize()
		end)
		local h = if ok then size.Y else 6
		local hum = target:FindFirstChildOfClass("Humanoid")
		if hum then
			local hrp = target:FindFirstChild("HumanoidRootPart")
			return hrp, 3.5 * target:GetScale()
		end
		return pp, h + 0.8
	elseif target:IsA("BasePart") then
		return target, target.Size.Y / 2 + 2
	end
	return nil, 0
end

function Effects.bubble(target: Instance?, text: string, duration: number?)
	if not target then
		return
	end
	local part, height = adorneeOf(target)
	if not part then
		return
	end
	local old = activeBubbles[target]
	if old then
		old:Destroy()
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "ThoughtBubble"
	bb.Size = UDim2.fromOffset(math.clamp(utf8.len(text) or 4, 3, 14) * 30 + 30, 70)
	bb.StudsOffsetWorldSpace = Vector3.new(0, height, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 80
	bb.LightInfluence = 0
	bb.Adornee = part
	local bubble = Instance.new("Frame")
	bubble.Size = UDim2.new(1, 0, 0, 50)
	bubble.BackgroundColor3 = Color3.fromRGB(255, 253, 245)
	local cr = Instance.new("UICorner")
	cr.CornerRadius = UDim.new(0.5, 0)
	cr.Parent = bubble
	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(60, 40, 28)
	st.Thickness = 2.5
	st.Parent = bubble
	bubble.Parent = bb
	-- «хвостик» мысли из кружочков
	for i, s in { 12, 7 } do
		local dot = Instance.new("Frame")
		dot.Size = UDim2.fromOffset(s, s)
		dot.Position = UDim2.new(0.5, -s / 2 + i * 6, 0, 50 + (i - 1) * 9)
		dot.BackgroundColor3 = Color3.fromRGB(255, 253, 245)
		local c2 = Instance.new("UICorner")
		c2.CornerRadius = UDim.new(0.5, 0)
		c2.Parent = dot
		local s2 = Instance.new("UIStroke")
		s2.Color = Color3.fromRGB(60, 40, 28)
		s2.Thickness = 2
		s2.Parent = dot
		dot.Parent = bb
	end
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = true
	l.Text = text
	l.TextColor3 = Color3.fromRGB(60, 40, 28)
	l.Parent = bubble
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.Parent = bubble
	bb.Parent = player:WaitForChild("PlayerGui")
	activeBubbles[target] = bb
	-- «пульс» появления
	local sc = Instance.new("UIScale")
	sc.Scale = 0.3
	sc.Parent = bubble
	TweenService:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(duration or 4, function()
		if activeBubbles[target] == bb then
			activeBubbles[target] = nil
		end
		bb:Destroy()
	end)
end

-- NPC сами «думают», когда ты рядом
local function ambientBubbles()
	task.spawn(function()
		while true do
			task.wait(1.6)
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp and root then
				for _, m in root.NPCs:GetChildren() do
					local list = m:GetAttribute("Bubbles")
					if list and not activeBubbles[m] and m:GetAttribute("LocallyHidden") ~= true then
						local ok, pivot = pcall(function()
							return m:GetPivot()
						end)
						if ok and (pivot.Position - hrp.Position).Magnitude < 24 and math.random() < 0.3 then
							local opts = string.split(list, "|")
							Effects.bubble(m, opts[math.random(1, #opts)], 3.5)
						end
					end
				end
			end
		end
	end)
end

----------------------------------------------------------------------
-- Двери и предметы, зависящие от сюжета (локально для игрока)
----------------------------------------------------------------------
local function setHidden(inst: Instance, hidden: boolean)
	local parts = inst:GetDescendants()
	table.insert(parts, inst)
	for _, p in parts do
		if p:IsA("BasePart") then
			if p:GetAttribute("OrigT") == nil then
				p:SetAttribute("OrigT", p.Transparency)
				p:SetAttribute("OrigC", p.CanCollide)
			end
			p.Transparency = if hidden then 1 else p:GetAttribute("OrigT")
			p.CanCollide = if hidden then false else p:GetAttribute("OrigC")
		elseif p:IsA("ProximityPrompt") then
			p.Enabled = not hidden
		elseif p:IsA("ParticleEmitter") or p:IsA("Light") then
			p.Enabled = not hidden
		end
	end
	if inst:IsA("Model") then
		for _, p in inst:GetDescendants() do
			if p:IsA("ProximityPrompt") then
				p.Enabled = not hidden
			end
		end
		inst:SetAttribute("LocallyHidden", hidden)
	end
end

local lastStage, lastData = nil, nil
local reapplyQueued = false

function Effects.applyStage(stage: number, data: any)
	lastStage, lastData = stage, data
	for _, d in CollectionService:GetTagged("StageDoor") do
		local need = d:GetAttribute("RequiredStage") or 99
		local open = stage >= need
		if d:GetAttribute("OpenState") ~= open then
			d:SetAttribute("OpenState", open)
			if open then
				TweenService:Create(d, TweenInfo.new(0.6), { Transparency = 1 }):Play()
				d.CanCollide = false
			else
				d.Transparency = 0
				d.CanCollide = d.Name == "Door"
			end
		end
	end
	if root then
		for _, m in root.NPCs:GetChildren() do
			local hideAt = m:GetAttribute("HideAtStage")
			if hideAt then
				setHidden(m, stage >= hideAt)
			end
		end
	end
	for _, p in CollectionService:GetTagged("StageHide") do
		local hideAt = p:GetAttribute("HideAtStage")
		if hideAt then
			setHidden(p, stage >= hideAt)
		end
	end
	-- подсказки-промпты частей Йозефа прячем, если уже собраны
	if root and data then
		for _, pp in root:GetDescendants() do
			if pp:IsA("ProximityPrompt") then
				local a = pp:GetAttribute("Action")
				if a == "JosefPart" then
					local got = data.parts[pp:GetAttribute("PartId")] == true
					pp.Enabled = not got
					if pp.Parent:IsA("BasePart") then
						pp.Parent.Transparency = if got then 1 else 0
						local tip = pp.Parent.Parent:FindFirstChild("AntennaTip")
						if tip and pp:GetAttribute("PartId") == "antenna" then
							tip.Transparency = if got then 1 else 0
						end
					end
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- Вращение болтов, вентилятора, флажки
----------------------------------------------------------------------
local boltBase: { [BasePart]: CFrame } = {}

local function animateWorld()
	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local cam = workspace.CurrentCamera
		local cpos = cam and cam.CFrame.Position or Vector3.zero
		for part, base in boltBase do
			if part.Parent then
				if (base.Position - cpos).Magnitude < 160 then
					local cf = base * CFrame.new(0, math.sin(t * 2 + base.Position.X) * 0.25, 0) * CFrame.Angles(0, t * 2.2 + base.Position.Z, 0)
					part.CFrame = cf
					local hole = part:FindFirstChild("Hole")
					if hole then
						hole.CFrame = cf
					end
				end
			else
				boltBase[part] = nil
			end
		end
	end)
	local function track(p)
		if p:IsA("BasePart") then
			boltBase[p] = CFrame.new(p.Position)
		end
	end
	for _, p in CollectionService:GetTagged("Bolt") do
		track(p)
	end
	CollectionService:GetInstanceAddedSignal("Bolt"):Connect(track)

	-- лопасти вентилятора
	task.spawn(function()
		local fan = root.NPCs:WaitForChild("Вентилятор", 30)
		if not fan then
			return
		end
		local blades = fan:WaitForChild("Blades")
		local hub = fan:WaitForChild("Hub")
		local base = {}
		for _, b in blades:GetChildren() do
			base[b] = hub.CFrame:ToObjectSpace(b.CFrame)
		end
		local angle = 0
		RunService.RenderStepped:Connect(function(dt)
			if fan:GetAttribute("LocallyHidden") then
				return
			end
			angle += dt * 6
			local center = hub.CFrame * CFrame.Angles(0, 0, angle)
			for b, off in base do
				b.CFrame = center * off
			end
		end)
	end)
end

----------------------------------------------------------------------
-- Маркер текущей цели
----------------------------------------------------------------------
local markerGui: any
function Effects.setMarker(target: Instance?, label: string?)
	if not markerGui then
		markerGui = Instance.new("BillboardGui")
		markerGui.Name = "QuestMarker"
		markerGui.Size = UDim2.fromOffset(120, 80)
		markerGui.AlwaysOnTop = true
		markerGui.LightInfluence = 0
		local arrow = Instance.new("TextLabel")
		arrow.Name = "Arrow"
		arrow.BackgroundTransparency = 1
		arrow.Size = UDim2.new(1, 0, 0, 44)
		arrow.Font = Enum.Font.FredokaOne
		arrow.TextScaled = true
		arrow.Text = "⬇️"
		arrow.Parent = markerGui
		local dist = Instance.new("TextLabel")
		dist.Name = "Dist"
		dist.BackgroundTransparency = 1
		dist.Size = UDim2.new(1, 0, 0, 30)
		dist.Position = UDim2.fromOffset(0, 44)
		dist.Font = Enum.Font.FredokaOne
		dist.TextScaled = true
		dist.TextColor3 = Color3.fromRGB(255, 220, 140)
		dist.TextStrokeTransparency = 0.3
		dist.Parent = markerGui
		markerGui.Parent = player:WaitForChild("PlayerGui")
		RunService.Heartbeat:Connect(function()
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local a = markerGui.Adornee
			if hrp and a and a:IsA("BasePart") then
				local d = (a.Position - hrp.Position).Magnitude
				markerGui.Dist.Text = (markerGui:GetAttribute("Label") or "") .. " " .. math.floor(d) .. " м"
				markerGui.Enabled = d > 6
				markerGui.Arrow.Position = UDim2.fromOffset(0, math.sin(os.clock() * 4) * 5)
			end
		end)
	end
	local part = nil
	if target then
		if target:IsA("Model") then
			part = target.PrimaryPart
		elseif target:IsA("BasePart") then
			part = target
		end
	end
	markerGui.Adornee = part
	markerGui:SetAttribute("Label", label or "")
	markerGui.Enabled = part ~= nil
end

----------------------------------------------------------------------
-- Паровые трамплины, двойной прыжок, толчки
----------------------------------------------------------------------
local airJumpsUsed = 0

local function isMine(hit: BasePart): boolean
	local char = player.Character
	return char ~= nil and hit:IsDescendantOf(char)
end

local function setupMovement()
	local lastBounce = 0
	local function hookBounce(p: BasePart)
		p.Touched:Connect(function(hit)
			if isMine(hit) and os.clock() - lastBounce > 0.4 then
				lastBounce = os.clock()
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if hrp then
					local v = hrp.AssemblyLinearVelocity
					hrp.AssemblyLinearVelocity = Vector3.new(v.X, p:GetAttribute("Power") or 80, v.Z)
					airJumpsUsed = 0
				end
			end
		end)
	end
	for _, p in CollectionService:GetTagged("Bounce") do
		hookBounce(p)
	end
	CollectionService:GetInstanceAddedSignal("Bounce"):Connect(hookBounce)

	UserInputService.JumpRequest:Connect(function()
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hum or not hrp then
			return
		end
		local st = hum:GetState()
		if st == Enum.HumanoidStateType.Freefall or st == Enum.HumanoidStateType.Jumping then
			local max = char:GetAttribute("AirJumps") or 0
			if airJumpsUsed < max and hrp.AssemblyLinearVelocity.Y < 30 then
				airJumpsUsed += 1
				local v = hrp.AssemblyLinearVelocity
				hrp.AssemblyLinearVelocity = Vector3.new(v.X, hum.JumpPower * 1.05, v.Z)
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
				-- огонёк из ранца
				local fx = Instance.new("Part")
				fx.Shape = Enum.PartType.Ball
				fx.Size = Vector3.new(1.4, 1.4, 1.4)
				fx.Material = Enum.Material.Neon
				fx.Color = Color3.fromRGB(255, 150, 60)
				fx.Anchored = true
				fx.CanCollide = false
				fx.CanQuery = false
				fx.CanTouch = false
				fx.CFrame = hrp.CFrame * CFrame.new(0, -1.5, 1)
				fx.Parent = workspace
				TweenService:Create(fx, TweenInfo.new(0.4), { Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1 }):Play()
				task.delay(0.45, function()
					fx:Destroy()
				end)
			end
		end
	end)

	local function onChar(char: Model)
		local hum = char:WaitForChild("Humanoid")
		airJumpsUsed = 0
		hum.StateChanged:Connect(function(_, new)
			if new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
				airJumpsUsed = 0
			end
		end)
	end
	if player.Character then
		task.spawn(onChar, player.Character)
	end
	player.CharacterAdded:Connect(onChar)
end

function Effects.knockback(dir: Vector3)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hrp and hum then
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
		hrp.AssemblyLinearVelocity = dir * 70 + Vector3.new(0, 35, 0)
	end
end

----------------------------------------------------------------------
-- Воспоминания, если долго стоять без дела (как в оригинале)
----------------------------------------------------------------------
function Effects.idleMemories(getData)
	task.spawn(function()
		local lastPos = nil
		local idle = 0
		while true do
			task.wait(1)
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp then
				if lastPos and (hrp.Position - lastPos).Magnitude < 0.5 then
					idle += 1
				else
					idle = 0
				end
				lastPos = hrp.Position
				if idle == 25 then
					local data = getData()
					local pool = {}
					for _, m in Config.Memories do
						if data and data.memories and data.memories[m.id] then
							table.insert(pool, m)
						end
					end
					if #pool == 0 then
						pool = { { bubble = "👧❤️❓" } }
					end
					Effects.bubble(char, pool[math.random(1, #pool)].bubble, 6)
					idle = -40
				end
			end
		end
	end)
end

----------------------------------------------------------------------
-- Кат-сцены
----------------------------------------------------------------------
function Effects.arrest(UI)
	UI.fade(true, 0.5, "🎩🎩🎩  ➡️  🤖  ➡️  🔒")
	task.wait(2.2)
	UI.fade(false, 0.8)
end

function Effects.band()
	local mus = root.NPCs:FindFirstChild("Диджеридушник")
	local notes = { "🎵", "🎶", "🎷", "🥁" }
	for i = 1, 8 do
		if mus then
			Effects.bubble(mus, notes[(i - 1) % #notes + 1] .. notes[i % #notes + 1], 1.2)
		end
		task.wait(1.1)
	end
end

-- Финал: Братство падает в сток, Йозеф и Берта улетают на закат.
function Effects.ending(UI, data)
	local cam = workspace.CurrentCamera
	local tower = root:FindFirstChild("Tower")
	local drain = tower and tower:FindFirstChild("Drain")
	if not drain then
		return
	end
	local scene = Instance.new("Folder")
	scene.Name = "EndingScene"
	scene.Parent = workspace
	local base = drain.CFrame
	-- Братство
	local caps = {}
	for i, k in { "Leader", "Fat", "Thin" } do
		local m = Art.BlackCap(k)
		m:PivotTo(base * CFrame.new((i - 2) * 5, 0.2, 6) * CFrame.Angles(0, math.rad(180), 0))
		m.Parent = scene
		caps[i] = m
	end
	local oldType = cam.CameraType
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame.lookAt(base.Position + Vector3.new(0, 14, 26), base.Position + Vector3.new(0, 2, 0))
	UI.fade(false, 0.3)
	for _, m in caps do
		Effects.bubble(m, "😱", 2)
	end
	task.wait(1.2)
	for i, m in caps do
		local start = m:GetPivot()
		task.spawn(function()
			for t = 0, 1, 0.04 do
				m:PivotTo(start:Lerp(base * CFrame.new(0, -1, 0), t) * CFrame.Angles(0, t * 6, 0))
				task.wait()
			end
			for t = 0, 1, 0.05 do
				m:PivotTo(base * CFrame.new(0, -1 - t * 15, 0) * CFrame.Angles(0, t * 12, 0))
				task.wait()
			end
			m:Destroy()
		end)
		task.wait(0.35 * i)
	end
	task.wait(2.5)
	-- летательный аппарат
	local craft = Instance.new("Model")
	craft.Name = "FlyingMachine"
	local O = CFrame.new()
	local seat = Art.part(craft, "Cyl", Vector3.new(6, 1.2, 6), O, C.Brass, Enum.Material.Metal, "Deck")
	craft.PrimaryPart = seat
	Art.part(craft, "Cyl", Vector3.new(0.4, 7, 0.4), O * CFrame.new(0, 4, 0), C.IronDark, Enum.Material.Metal, "Mast")
	local rotor = Art.part(craft, "Block", Vector3.new(12, 0.2, 0.8), O * CFrame.new(0, 7.6, 0), C.RustLight, Enum.Material.Wood, "Rotor")
	Art.part(craft, "Ball", Vector3.new(5, 5, 5), O * CFrame.new(0, 11, 0), Color3.fromRGB(200, 90, 70), Enum.Material.Fabric, "Balloon")
	local skin = Config.JosefSkins[1]
	for _, s in Config.JosefSkins do
		if s.id == data.skin then
			skin = s
		end
	end
	local j = Art.Josef(skin.body, skin.dark)
	j:PivotTo(O * CFrame.new(-1.3, 0.6, 0) * CFrame.Angles(0, math.rad(180), 0))
	j.Parent = craft
	local dressC = Config.BertaDresses[1].color
	for _, d in Config.BertaDresses do
		if d.id == data.dress then
			dressC = d.color
		end
	end
	local b = Art.Berta(dressC, data.berta and data.berta.love or 0)
	b:PivotTo(O * CFrame.new(1.4, 0.6, 0) * CFrame.Angles(0, math.rad(180), 0))
	b.Parent = craft
	for _, p in craft:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = false
		end
	end
	local startCf = base * CFrame.new(0, 3, -4)
	craft:PivotTo(startCf)
	craft.Parent = scene
	Effects.bubble(j, "🤖❤️👧", 3)
	Effects.bubble(b, "😊🌅", 3)
	-- «закат» — туда, где солнце
	local sunDir = game:GetService("Lighting"):GetSunDirection()
	local flat = Vector3.new(sunDir.X, 0, sunDir.Z)
	if flat.Magnitude < 0.1 then
		flat = Vector3.new(1, 0, 0)
	end
	flat = flat.Unit
	local t0 = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - t0
		local pos = startCf.Position + flat * (t * t * 3 + t * 4) + Vector3.new(0, t * 5, 0)
		craft:PivotTo(CFrame.lookAt(pos, pos + flat) * CFrame.Angles(0, math.rad(90), 0))
		rotor.CFrame = craft:GetPivot() * CFrame.new(0, 7.6, 0) * CFrame.Angles(0, t * 20, 0)
		cam.CFrame = CFrame.lookAt(startCf.Position + Vector3.new(-flat.Z * 30, 18, flat.X * 30) - flat * 10, pos)
	end)
	task.wait(9)
	conn:Disconnect()
	UI.fade(true, 1, "")
	task.wait(1.2)
	scene:Destroy()
	cam.CameraType = oldType == Enum.CameraType.Scriptable and Enum.CameraType.Custom or oldType
	UI.fade(true, 0.1, "<b>КОНЕЦ</b>\n\nПо мотивам Machinarium (Amanita Design, 2009)\nРежиссёр оригинала — Якуб Дворский · Музыка — Floex\n\nФанатская игра для Roblox")
	task.wait(5)
	UI.fade(false, 1.5)
end

----------------------------------------------------------------------
-- детали могут появиться позже (стриминг, пересоздание) — применяем сюжет заново
local function queueReapply()
	if reapplyQueued or not lastStage then
		return
	end
	reapplyQueued = true
	task.delay(0.3, function()
		reapplyQueued = false
		Effects.applyStage(lastStage, lastData)
	end)
end

function Effects.Init()
	root = workspace:WaitForChild("Machinarium")
	CollectionService:GetInstanceAddedSignal("StageDoor"):Connect(queueReapply)
	CollectionService:GetInstanceAddedSignal("StageHide"):Connect(queueReapply)
	root:WaitForChild("NPCs").ChildAdded:Connect(queueReapply)
	ambientBubbles()
	animateWorld()
	setupMovement()
end

return Effects
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Minigames</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Мини-игры: «Пять в ряд», вопросы Вентилятора, бомба, пауки из книги подсказок.

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Machinarium"):WaitForChild("Config"))
local C = Config.Colors

local Minigames = {}

----------------------------------------------------------------------
-- ПЯТЬ В РЯД (гомоку) против робота из паба
----------------------------------------------------------------------
local N = 11
local DIRS = { { 1, 0 }, { 0, 1 }, { 1, 1 }, { 1, -1 } }

local function inside(x, y)
	return x >= 1 and x <= N and y >= 1 and y <= N
end

local function countLine(board, x, y, dx, dy, who)
	local n = 0
	local cx, cy = x + dx, y + dy
	while inside(cx, cy) and board[cx][cy] == who do
		n += 1
		cx += dx
		cy += dy
	end
	local open = inside(cx, cy) and board[cx][cy] == 0
	return n, open
end

local function wins(board, x, y, who)
	for _, d in DIRS do
		local a = countLine(board, x, y, d[1], d[2], who)
		local b = countLine(board, x, y, -d[1], -d[2], who)
		if a + b + 1 >= 5 then
			return true
		end
	end
	return false
end

-- оценка клетки для игрока who
local function scoreCell(board, x, y, who)
	local total = 0
	for _, d in DIRS do
		local a, oa = countLine(board, x, y, d[1], d[2], who)
		local b, ob = countLine(board, x, y, -d[1], -d[2], who)
		local len = a + b + 1
		local opens = (if oa then 1 else 0) + (if ob then 1 else 0)
		if len >= 5 then
			total += 100000
		elseif len == 4 then
			total += if opens == 2 then 12000 elseif opens == 1 then 2500 else 0
		elseif len == 3 then
			total += if opens == 2 then 1200 elseif opens == 1 then 150 else 0
		elseif len == 2 then
			total += if opens == 2 then 100 elseif opens == 1 then 20 else 0
		else
			total += opens
		end
	end
	return total
end

local function aiMove(board)
	local best, bx, by = -1, math.ceil(N / 2), math.ceil(N / 2)
	for x = 1, N do
		for y = 1, N do
			if board[x][y] == 0 then
				-- только клетки рядом с фишками
				local near = false
				for ddx = -2, 2 do
					for ddy = -2, 2 do
						if inside(x + ddx, y + ddy) and board[x + ddx][y + ddy] ~= 0 then
							near = true
						end
					end
				end
				if near then
					local s = scoreCell(board, x, y, 2) * 1.1 + scoreCell(board, x, y, 1) + math.random() * 5
					if s > best then
						best, bx, by = s, x, y
					end
				end
			end
		end
	end
	return bx, by
end

function Minigames.Gomoku(UI, onDone: (boolean) -> ())
	local finished = false
	local won = false
	local _, content = UI.window("⚫⚪ Пять в ряд", 560, 640, function()
		onDone(won)
	end)
	local info = UI.label(content, "Ты — ⚫. Собери 5 в ряд (по горизонтали, вертикали или диагонали).", UDim2.new(1, 0, 0, 44), nil, 18)
	local boardFrame = Instance.new("Frame")
	local cell = 44
	boardFrame.Size = UDim2.fromOffset(cell * N, cell * N)
	boardFrame.Position = UDim2.new(0.5, -cell * N / 2, 0, 50)
	boardFrame.BackgroundColor3 = Color3.fromRGB(210, 180, 130)
	UI.corner(boardFrame, 8)
	UI.stroke(boardFrame, UI.Ink, 3)
	boardFrame.Parent = content
	local board = {}
	local buttons = {}
	for x = 1, N do
		board[x] = {}
		buttons[x] = {}
		for y = 1, N do
			board[x][y] = 0
			local b = Instance.new("TextButton")
			b.Size = UDim2.fromOffset(cell - 2, cell - 2)
			b.Position = UDim2.fromOffset((x - 1) * cell + 1, (y - 1) * cell + 1)
			b.BackgroundColor3 = Color3.fromRGB(226, 200, 150)
			b.BackgroundTransparency = 0.3
			b.Text = ""
			b.TextSize = 30
			b.Font = UI.Font
			b.AutoButtonColor = true
			b.Parent = boardFrame
			buttons[x][y] = b
		end
	end
	local busy = false
	local function place(x, y, who)
		board[x][y] = who
		buttons[x][y].Text = if who == 1 then "⚫" else "⚪"
		buttons[x][y].AutoButtonColor = false
	end
	local function finish(playerWon: boolean, draw: boolean?)
		finished = true
		won = playerWon
		if draw then
			info.Text = "<b>Ничья!</b> Закрой окно и попробуй ещё раз."
		elseif playerWon then
			info.Text = "<b>🏆 Победа!</b> Робот в шоке. Закрой окно, чтобы забрать награду."
		else
			info.Text = "<b>🤖 Робот победил.</b> Закрой окно и сыграй снова."
		end
	end
	local moves = 0
	for x = 1, N do
		for y = 1, N do
			buttons[x][y].Activated:Connect(function()
				if finished or busy or board[x][y] ~= 0 then
					return
				end
				place(x, y, 1)
				moves += 1
				if wins(board, x, y, 1) then
					finish(true)
					return
				end
				if moves >= N * N then
					finish(false, true)
					return
				end
				busy = true
				info.Text = "🤖 думает…"
				task.wait(0.35)
				local ax, ay = aiMove(board)
				place(ax, ay, 2)
				buttons[ax][ay].BackgroundColor3 = Color3.fromRGB(240, 220, 170)
				moves += 1
				busy = false
				if wins(board, ax, ay, 2) then
					finish(false)
				elseif moves >= N * N then
					finish(false, true)
				else
					info.Text = "Твой ход ⚫"
				end
			end)
		end
	end
end

----------------------------------------------------------------------
-- ВОПРОСЫ ВЕНТИЛЯТОРА
----------------------------------------------------------------------
function Minigames.Quiz(UI, startAnger: number, answer: (number, number) -> any)
	local _, content = UI.window("🌀 Вентилятор спрашивает", 520, 420)
	local anger = startAnger or 0
	local meter = UI.label(content, "", UDim2.new(1, 0, 0, 30), nil, 20)
	local qLabel = UI.label(content, "", UDim2.new(1, 0, 0, 70), UDim2.fromOffset(0, 34), 24)
	local hint = UI.label(content, "<i>Подсказка из оригинала: вентилятор надо… разозлить 😈. А за правильные ответы дают болты.</i>", UDim2.new(1, 0, 0, 44), UDim2.new(0, 0, 1, -44), 16, Color3.fromRGB(120, 90, 70))
	local _h = hint
	local btns = {}
	local order = {}
	for i = 1, #Config.FanQuiz do
		order[i] = i
	end
	for i = #order, 2, -1 do
		local j = math.random(1, i)
		order[i], order[j] = order[j], order[i]
	end
	local cur = 1
	local function updateMeter()
		meter.Text = "Злость вентилятора: " .. string.rep("😤", anger) .. string.rep("⚪", math.max(0, Config.FanAngerToOpen - anger))
	end
	local function show()
		local q = Config.FanQuiz[order[(cur - 1) % #order + 1]]
		qLabel.Text = "<b>" .. q.q .. "</b>"
		for i, b in btns do
			b.Text = q.a[i] or ""
			b.Visible = q.a[i] ~= nil
		end
	end
	local locked = false
	for i = 1, 3 do
		local b = UI.button(content, "", UDim2.new(1, 0, 0, 48), UDim2.fromOffset(0, 110 + (i - 1) * 56), C.RustLight)
		btns[i] = b
		b.Activated:Connect(function()
			if locked then
				return
			end
			locked = true
			local idx = order[(cur - 1) % #order + 1]
			local res = answer(idx, i)
			if res then
				anger = res.anger
				updateMeter()
				b.BackgroundColor3 = if res.correct then Color3.fromRGB(110, 170, 90) else Color3.fromRGB(190, 80, 60)
				if res.opened then
					qLabel.Text = "<b>ВЖЖЖЖУХ!</b> Вентилятор взбесился и улетел. Путь в теплицу открыт!"
					for _, bb in btns do
						bb.Visible = false
					end
					task.wait(2.5)
					UI.closeWindow()
					return
				end
			end
			task.wait(0.7)
			b.BackgroundColor3 = C.RustLight
			cur += 1
			show()
			locked = false
		end)
	end
	updateMeter()
	show()
end

----------------------------------------------------------------------
-- БОМБА
----------------------------------------------------------------------
function Minigames.Bomb(UI, seq: { string }, submit: ({ string }) -> boolean)
	local _, content = UI.window("💣 Бомба Братства Чёрной Шляпы", 520, 440)
	local wireById = {}
	for _, w in Config.BombWires do
		wireById[w.id] = w
	end
	local info = UI.label(content, "Главарь Братства думает о порядке проводов… Запоминай!", UDim2.new(1, 0, 0, 50), nil, 20)
	-- пузырь мыслей главаря
	local bubble = UI.panel(content, UDim2.new(1, 0, 0, 90), UDim2.fromOffset(0, 56), Color3.fromRGB(255, 255, 250))
	local bl = UI.label(bubble, "", UDim2.fromScale(1, 1), nil, 52)
	bl.TextXAlignment = Enum.TextXAlignment.Center
	local s = "🎩💭 "
	for _, id in seq do
		s ..= wireById[id].emoji
	end
	bl.Text = s
	local timer = UI.label(content, "", UDim2.new(1, 0, 0, 30), UDim2.fromOffset(0, 154), 22, Color3.fromRGB(190, 50, 40))
	local picked = {}
	local wireBtns = {}
	local done = false
	for i, w in Config.BombWires do
		local b = UI.button(content, "✂️ " .. w.name, UDim2.new(0.5, -6, 0, 50), UDim2.new(((i - 1) % 2) * 0.5, ((i - 1) % 2) * 6, 0, 196 + math.floor((i - 1) / 2) * 58), w.color)
		b.Visible = false
		wireBtns[w.id] = b
		b.Activated:Connect(function()
			if done or table.find(picked, w.id) then
				return
			end
			table.insert(picked, w.id)
			b.Text = "✂️ " .. #picked
			b.BackgroundTransparency = 0.5
			if #picked == #seq then
				done = true
				local ok = submit(picked)
				if ok then
					info.Text = "<b>Фух! Бомба обезврежена.</b>"
					bubble.Visible = true
					bl.Text = "💣❌ 😅"
					task.wait(2)
					UI.closeWindow()
				else
					info.Text = "<b>Не тот порядок!</b> Закрой окно и попробуй снова."
				end
			end
		end)
	end
	task.spawn(function()
		for t = 4, 1, -1 do
			timer.Text = "Пузырь исчезнет через " .. t .. "…"
			task.wait(1)
			if not content.Parent then
				return
			end
		end
		bubble.Visible = false
		timer.Text = "⏱️ Режь провода по порядку!"
		info.Text = "Какой был порядок? Нажимай провода."
		for _, b in wireBtns do
			b.Visible = true
		end
	end)
end

----------------------------------------------------------------------
-- ПАУКИ: мини-игра на обложке книги подсказок
-- Веди ключ (W/S, стрелки или мышь), стреляй (пробел/клик) и доведи до замка.
----------------------------------------------------------------------
function Minigames.Spiders(UI, onDone: (boolean) -> ())
	local success = false
	local conns = {}
	local _, content = UI.window("📖 Книга подсказок заперта", 600, 440, function()
		for _, c in conns do
			c:Disconnect()
		end
		onDone(success)
	end)
	UI.label(content, "Веди 🗝️ к замку: <b>W/S</b> или мышь — вверх/вниз, <b>пробел/клик</b> — стрелять в пауков.", UDim2.new(1, 0, 0, 44), nil, 17)
	local W, H = 560, 280
	local field = Instance.new("Frame")
	field.Size = UDim2.fromOffset(W, H)
	field.Position = UDim2.new(0.5, -W / 2, 0, 50)
	field.BackgroundColor3 = Color3.fromRGB(60, 46, 36)
	field.ClipsDescendants = true
	UI.corner(field, 10)
	UI.stroke(field, UI.Ink, 3)
	field.Parent = content
	-- кирпичи на фоне (иногда складываются в «rebol»)
	local letters = { "R", "E", "B", "O", "L" }
	local showRebol = math.random() < 0.5
	for i = 0, 13 do
		for j = 0, 6 do
			local b = Instance.new("TextLabel")
			b.Size = UDim2.fromOffset(38, 18)
			b.Position = UDim2.fromOffset(i * 40 + (j % 2) * 20, j * 40 + 10)
			b.BackgroundColor3 = Color3.fromRGB(90, 66, 50)
			b.BorderSizePixel = 0
			b.Font = UI.Font
			b.TextSize = 14
			b.TextColor3 = Color3.fromRGB(150, 120, 90)
			b.Text = if showRebol and j == 3 and i >= 4 and i <= 8 then letters[i - 3] else ""
			b.Parent = field
		end
	end
	local function sprite(text: string, size: number): TextLabel
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromOffset(size, size)
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Text = text
		l.TextSize = size
		l.Font = UI.Font
		l.ZIndex = 5
		l.Parent = field
		return l
	end
	local key = sprite("🗝️", 30)
	local lock = sprite("🔒", 40)
	local keyY = H / 2
	local keyX = 40
	local progress = 0
	local LENGTH = 22 -- секунд до замка
	local spiders = {}
	local bullets = {}
	local spawnT = 0
	local status = UI.label(content, "", UDim2.new(1, 0, 0, 30), UDim2.new(0, 0, 0, 336), 20)
	local running = true
	local cooldown = 0

	local function reset()
		for _, s in spiders do
			s.l:Destroy()
		end
		for _, b in bullets do
			b.l:Destroy()
		end
		spiders, bullets = {}, {}
		progress = 0
		keyY = H / 2
	end
	local function shoot()
		if not running or cooldown > 0 then
			return
		end
		cooldown = 0.18
		local b = sprite("•", 22)
		b.TextColor3 = Color3.fromRGB(255, 220, 120)
		table.insert(bullets, { l = b, x = keyX + 16, y = keyY })
	end
	table.insert(conns, UserInputService.InputBegan:Connect(function(input, gp)
		if input.KeyCode == Enum.KeyCode.Space or input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			shoot()
		end
	end))
	table.insert(conns, RunService.RenderStepped:Connect(function(dt)
		if not running or not field.Parent then
			return
		end
		cooldown = math.max(0, cooldown - dt)
		-- управление
		local dy = 0
		if UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then
			dy -= 1
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
			dy += 1
		end
		if dy ~= 0 then
			keyY += dy * 180 * dt
		else
			local m = UserInputService:GetMouseLocation()
			local ap = field.AbsolutePosition
			local rel = m.Y - ap.Y - GuiService:GetGuiInset().Y -- поправка на верхнюю панель Roblox
			if m.X > ap.X and m.X < ap.X + field.AbsoluteSize.X and rel > 0 and rel < field.AbsoluteSize.Y then
				keyY += (rel / field.AbsoluteSize.Y * H - keyY) * math.min(1, dt * 8)
			end
		end
		keyY = math.clamp(keyY, 18, H - 18)
		key.Position = UDim2.fromOffset(keyX, keyY)
		progress += dt / LENGTH
		lock.Position = UDim2.fromOffset(W + 30 - progress * (W - keyX), H / 2)
		status.Text = "До замка: " .. math.floor(progress * 100) .. "%"
		-- пауки
		spawnT -= dt
		if spawnT <= 0 and progress < 0.92 then
			spawnT = 0.55 + math.random() * 0.5
			local s = sprite("🕷️", 30)
			table.insert(spiders, { l = s, x = W + 20, y = math.random(20, H - 20), v = 90 + math.random() * 70, wob = math.random() * 6 })
		end
		for i = #spiders, 1, -1 do
			local s = spiders[i]
			s.x -= s.v * dt
			s.y += math.sin(os.clock() * 4 + s.wob) * 30 * dt
			s.l.Position = UDim2.fromOffset(s.x, s.y)
			if (Vector2.new(s.x, s.y) - Vector2.new(keyX, keyY)).Magnitude < 24 then
				-- паук отбрасывает ключ назад, но не в самое начало
				local keep = math.max(0, progress - 0.25)
				reset()
				progress = keep
				status.Text = "🕷️ Паук укусил ключ! Отброшен назад…"
				return
			end
			if s.x < -20 then
				s.l:Destroy()
				table.remove(spiders, i)
			end
		end
		for i = #bullets, 1, -1 do
			local b = bullets[i]
			b.x += 420 * dt
			b.l.Position = UDim2.fromOffset(b.x, b.y)
			local hit = false
			for j = #spiders, 1, -1 do
				local s = spiders[j]
				if (Vector2.new(s.x, s.y) - Vector2.new(b.x, b.y)).Magnitude < 22 then
					s.l:Destroy()
					table.remove(spiders, j)
					hit = true
					break
				end
			end
			if hit or b.x > W + 10 then
				b.l:Destroy()
				table.remove(bullets, i)
			end
		end
		if progress >= 1 then
			running = false
			success = true
			status.Text = "<b>🔓 Замок открыт!</b> Закрой окно — книга откроется."
			lock.Text = "🔓"
		end
	end))
end

return Minigames
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- UI: интерфейс в стиле старой бумаги и ржавого металла.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Machinarium"):WaitForChild("Config"))
local C = Config.Colors

local UI = {}

local player = Players.LocalPlayer
local gui: ScreenGui
local toastHolder: Frame
local currentWindow: Frame? = nil

UI.Font = Enum.Font.FredokaOne
UI.Paper = C.Paper
UI.Ink = Color3.fromRGB(60, 40, 28)
UI.Rust = C.Rust

function UI.corner(parent: Instance, r: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 12)
	c.Parent = parent
	return c
end

function UI.stroke(parent: Instance, color: Color3?, thick: number?)
	local s = Instance.new("UIStroke")
	s.Color = color or UI.Ink
	s.Thickness = thick or 3
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

function UI.pad(parent: Instance, px: number)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.PaddingTop = UDim.new(0, px)
	p.PaddingBottom = UDim.new(0, px)
	p.Parent = parent
	return p
end

function UI.label(parent: Instance, text: string, size: UDim2, pos: UDim2?, textSize: number?, color: Color3?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = pos or UDim2.new()
	l.Font = UI.Font
	l.Text = text
	l.TextSize = textSize or 20
	l.TextColor3 = color or UI.Ink
	l.TextWrapped = true
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.RichText = true
	l.Parent = parent
	return l
end

function UI.button(parent: Instance, text: string, size: UDim2, pos: UDim2?, color: Color3?, onClick: (() -> ())?): TextButton
	local b = Instance.new("TextButton")
	b.AutoButtonColor = true
	b.Size = size
	b.Position = pos or UDim2.new()
	b.BackgroundColor3 = color or C.RustLight
	b.Font = UI.Font
	b.Text = text
	b.TextSize = 20
	b.TextColor3 = Color3.fromRGB(255, 248, 232)
	b.TextStrokeTransparency = 0.6
	b.TextWrapped = true
	UI.corner(b, 10)
	UI.stroke(b, UI.Ink, 2)
	b.Parent = parent
	if onClick then
		b.Activated:Connect(onClick)
	end
	return b
end

function UI.panel(parent: Instance, size: UDim2, pos: UDim2?, color: Color3?): Frame
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = pos or UDim2.new()
	f.BackgroundColor3 = color or UI.Paper
	UI.corner(f, 14)
	UI.stroke(f, UI.Ink, 3)
	f.Parent = parent
	return f
end

function UI.list(parent: Instance, padding: number?, horizontal: boolean?): UIListLayout
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, padding or 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	if horizontal then
		l.FillDirection = Enum.FillDirection.Horizontal
	end
	l.Parent = parent
	return l
end

function UI.scroll(parent: Instance, size: UDim2, pos: UDim2?): ScrollingFrame
	local s = Instance.new("ScrollingFrame")
	s.Size = size
	s.Position = pos or UDim2.new()
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.ScrollBarThickness = 8
	s.ScrollBarImageColor3 = C.RustDark
	s.CanvasSize = UDim2.new()
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.Parent = parent
	return s
end

----------------------------------------------------------------------
-- Окна
----------------------------------------------------------------------
function UI.closeWindow()
	if currentWindow then
		currentWindow:Destroy()
		currentWindow = nil
	end
end

function UI.isOpen(): boolean
	return currentWindow ~= nil
end

-- Окно по центру. Возвращает frame, content, close()
function UI.window(title: string, w: number, h: number, onClose: (() -> ())?)
	UI.closeWindow()
	local vp = workspace.CurrentCamera.ViewportSize
	w = math.min(w, vp.X - 24)
	h = math.min(h, vp.Y - 90)
	local f = UI.panel(gui, UDim2.fromOffset(w, h), UDim2.new(0.5, -w / 2, 0.5, -h / 2 + 10))
	f.ZIndex = 10
	-- «ржавая» шапка
	local head = Instance.new("Frame")
	head.Size = UDim2.new(1, 0, 0, 44)
	head.BackgroundColor3 = C.Rust
	UI.corner(head, 12)
	head.Parent = f
	local t = UI.label(head, title, UDim2.new(1, -60, 1, 0), UDim2.fromOffset(16, 0), 24, Color3.fromRGB(255, 244, 222))
	t.TextStrokeTransparency = 0.5
	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		if currentWindow == f then
			currentWindow = nil
		end
		f:Destroy()
		if onClose then
			onClose()
		end
	end
	local x = UI.button(head, "✕", UDim2.fromOffset(36, 36), UDim2.new(1, -42, 0, 4), Color3.fromRGB(170, 70, 50), close)
	x.TextSize = 22
	local content = Instance.new("Frame")
	content.BackgroundTransparency = 1
	content.Size = UDim2.new(1, -24, 1, -60)
	content.Position = UDim2.fromOffset(12, 52)
	content.Parent = f
	currentWindow = f
	f.Destroying:Connect(function()
		if not closed then
			closed = true
			if currentWindow == f then
				currentWindow = nil
			end
			if onClose then
				onClose()
			end
		end
	end)
	-- появление
	local sc = Instance.new("UIScale")
	sc.Scale = 0.85
	sc.Parent = f
	TweenService:Create(sc, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	return f, content, close
end

----------------------------------------------------------------------
-- Всплывающие сообщения
----------------------------------------------------------------------
local kindColors = {
	info = Color3.fromRGB(236, 222, 190),
	good = Color3.fromRGB(200, 230, 170),
	bad = Color3.fromRGB(240, 170, 150),
	quest = Color3.fromRGB(255, 214, 130),
}

function UI.toast(text: string, kind: string?)
	local f = UI.panel(toastHolder, UDim2.new(1, 0, 0, 0), nil, kindColors[kind or "info"] or kindColors.info)
	f.AutomaticSize = Enum.AutomaticSize.Y
	UI.pad(f, 8)
	local l = UI.label(f, text, UDim2.new(1, 0, 0, 0), nil, 19)
	l.AutomaticSize = Enum.AutomaticSize.Y
	l.TextXAlignment = Enum.TextXAlignment.Center
	f.BackgroundTransparency = 1
	TweenService:Create(f, TweenInfo.new(0.2), { BackgroundTransparency = 0 }):Play()
	task.delay(if kind == "quest" then 6 else 4, function()
		if f.Parent then
			local tw = TweenService:Create(f, TweenInfo.new(0.4), { BackgroundTransparency = 1 })
			TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
			local st = f:FindFirstChildOfClass("UIStroke")
			if st then
				TweenService:Create(st, TweenInfo.new(0.4), { Transparency = 1 }):Play()
			end
			tw:Play()
			tw.Completed:Wait()
			f:Destroy()
		end
	end)
	-- не больше 5 сообщений сразу
	local items = {}
	for _, c in toastHolder:GetChildren() do
		if c:IsA("Frame") then
			table.insert(items, c)
		end
	end
	if #items > 5 then
		items[1]:Destroy()
	end
end

-- Большая «карточка» по центру (факт, пасхалка, воспоминание)
function UI.card(title: string, body: string, emoji: string?, color: Color3?)
	local f = UI.panel(gui, UDim2.fromOffset(460, 0), UDim2.new(0.5, -230, 0.18, 0), color or UI.Paper)
	f.AutomaticSize = Enum.AutomaticSize.Y
	f.ZIndex = 20
	UI.pad(f, 14)
	UI.list(f, 6)
	if emoji then
		local e = UI.label(f, emoji, UDim2.new(1, 0, 0, 56), nil, 48)
		e.TextXAlignment = Enum.TextXAlignment.Center
	end
	local t = UI.label(f, "<b>" .. title .. "</b>", UDim2.new(1, 0, 0, 30), nil, 26)
	t.TextXAlignment = Enum.TextXAlignment.Center
	local b = UI.label(f, body, UDim2.new(1, 0, 0, 0), nil, 20)
	b.AutomaticSize = Enum.AutomaticSize.Y
	b.TextXAlignment = Enum.TextXAlignment.Center
	local ok = UI.button(f, "Понятно", UDim2.new(1, 0, 0, 40), nil, C.Rust, function()
		f:Destroy()
	end)
	ok.LayoutOrder = 10
	local sc = Instance.new("UIScale")
	sc.Scale = 0.7
	sc.Parent = f
	TweenService:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(12, function()
		if f.Parent then
			f:Destroy()
		end
	end)
	return f
end

function UI.fade(toBlack: boolean, time: number?, text: string?)
	local f = gui:FindFirstChild("Fade") :: Frame
	if not f then
		f = Instance.new("Frame")
		f.Name = "Fade"
		f.Size = UDim2.fromScale(1, 1)
		f.BackgroundColor3 = Color3.new(0, 0, 0)
		f.BackgroundTransparency = 1
		f.ZIndex = 50
		f.Parent = gui
		local l = UI.label(f, "", UDim2.fromScale(1, 1), nil, 40, Color3.fromRGB(255, 240, 220))
		l.Name = "Text"
		l.TextXAlignment = Enum.TextXAlignment.Center
		l.ZIndex = 51
	end
	local l = f:FindFirstChild("Text") :: TextLabel
	l.Text = text or ""
	TweenService:Create(f, TweenInfo.new(time or 0.6), { BackgroundTransparency = if toBlack then 0 else 1 }):Play()
	TweenService:Create(l, TweenInfo.new(time or 0.6), { TextTransparency = if toBlack then 0 else 1 }):Play()
end

function UI.Init()
	gui = Instance.new("ScreenGui")
	gui.Name = "MachinariumUI"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.IgnoreGuiInset = false
	gui.Parent = player:WaitForChild("PlayerGui")
	UI.Gui = gui

	toastHolder = Instance.new("Frame")
	toastHolder.Name = "Toasts"
	toastHolder.BackgroundTransparency = 1
	toastHolder.Size = UDim2.new(0, 420, 0.5, 0)
	toastHolder.Position = UDim2.new(0.5, -210, 0, 70)
	toastHolder.Parent = gui
	local l = UI.list(toastHolder, 6)
	l.VerticalAlignment = Enum.VerticalAlignment.Top

	-- мелкие экраны (телефон)
	local sc = Instance.new("UIScale")
	sc.Parent = gui
	local function rescale()
		local vp = workspace.CurrentCamera.ViewportSize
		sc.Scale = math.clamp(math.min(vp.X / 1100, vp.Y / 700), 0.6, 1)
	end
	rescale()
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	return gui
end

return UI
]]></ProtectedString></Properties></Item>
</Item>
</Item>
