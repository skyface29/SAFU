# Скопируй в .env и заполни. Подробно — в README.md

# Токен бота от @BotFather
BOT_TOKEN=

# Домен сервера (на него должна смотреть A-запись). По нему откроется мини-приложение: https://DOMAIN
DOMAIN=dz.example.ru

# Твой Telegram id (узнать: @userinfobot) — подтверждать преподавателей, /stats. Можно несколько через запятую
ADMIN_IDS=

# Короткое имя мини-приложения из BotFather (/newapp) — для ссылок «открыть приложение» из чатов групп. Можно не заполнять
APP_NAME=

# Необязательно: id закрытого канала, куда бот складывает фото из мини-приложения (иначе — в личку автору)
STORAGE_CHAT_ID=

# Вебхук вместо long polling (1 — включить; нужен https)
WEBHOOK=1

# Ночной обход РУЗ, чтобы знать всех преподавателей (0 — выключить)
CRAWL=1
